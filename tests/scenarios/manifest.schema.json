{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fdai.dev/schemas/scenario-manifest/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenario_set_version", "status", "capability_packs"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "scenario_set_version": {"type": "string", "pattern": "^v\\d{4}\\.\\d{2}$"},
    "status": {"enum": ["incomplete", "complete"]},
    "capability_packs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sre", "arb_change_safety", "finops", "dr", "chaos"],
      "patternProperties": {
        "^(sre|arb_change_safety|finops|dr|chaos)$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "scenario_ids", "coverage"],
          "properties": {
            "status": {"enum": ["missing", "partial", "complete"]},
            "scenario_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "coverage": {
              "type": "object",
              "additionalProperties": false,
              "required": ["successful_full_loop", "unknown_or_deny", "cross_objective_conflict", "partial_failure_recovery", "a3e_or_non_applicability", "deterministic_replay_with_evidence"],
              "properties": {
                "successful_full_loop": {"type": "boolean"},
                "unknown_or_deny": {"type": "boolean"},
                "cross_objective_conflict": {"type": "boolean"},
                "partial_failure_recovery": {"type": "boolean"},
                "a3e_or_non_applicability": {"type": "boolean"},
                "deterministic_replay_with_evidence": {"type": "boolean"}
              }
            }
          }
        }
      }
    }
  }
}
