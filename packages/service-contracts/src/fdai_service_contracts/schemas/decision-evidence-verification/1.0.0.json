{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fdai.dev/service-contracts/decision-evidence-verification/1.0.0",
  "title": "Decision Evidence Verification Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_digest",
    "verifier_id",
    "verifier_version",
    "trust_anchor_id",
    "verified_at",
    "valid_until",
    "proofs",
    "revoked",
    "execution_authority",
    "bundle_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "receipt_digest": {
      "$ref": "#/$defs/digest"
    },
    "verifier_id": {
      "$ref": "#/$defs/verifier_id"
    },
    "verifier_version": {
      "$ref": "#/$defs/semver"
    },
    "trust_anchor_id": {
      "$ref": "#/$defs/trust_anchor_id"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time"
    },
    "proofs": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/proof"
      }
    },
    "revoked": {
      "const": false
    },
    "execution_authority": {
      "const": false
    },
    "bundle_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "verifier_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
    },
    "trust_anchor_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@-]{0,511}$"
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "receipt_digest",
        "subject_digest",
        "proof_digest",
        "verifier_id",
        "verifier_version",
        "trust_anchor_id",
        "issued_at",
        "valid_until",
        "revoked",
        "execution_authority"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "kind": {
          "enum": [
            "authentication",
            "completeness",
            "conflict",
            "evidence",
            "freshness_policy"
          ]
        },
        "receipt_digest": {
          "$ref": "#/$defs/digest"
        },
        "subject_digest": {
          "$ref": "#/$defs/digest"
        },
        "proof_digest": {
          "$ref": "#/$defs/digest"
        },
        "verifier_id": {
          "$ref": "#/$defs/verifier_id"
        },
        "verifier_version": {
          "$ref": "#/$defs/semver"
        },
        "trust_anchor_id": {
          "$ref": "#/$defs/trust_anchor_id"
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        },
        "revoked": {
          "const": false
        },
        "execution_authority": {
          "const": false
        }
      }
    }
  }
}
