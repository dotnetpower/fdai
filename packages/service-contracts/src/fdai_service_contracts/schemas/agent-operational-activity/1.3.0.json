{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fdai.example/schemas/agent-operational-activity/1.3.0.json",
  "title": "AgentOperationalActivity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type", "schema_version", "activity_id", "activity_instance_id",
    "idempotency_key", "kind", "status", "owner_agent", "producer",
    "observation_domain", "observed_at", "source", "freshness",
    "evidence_count", "duration_ms", "correlation_id", "reason_codes",
    "summary_key", "scope_class", "target_count", "result_state",
    "result_count", "result_unit", "source_cutoff", "started_at",
    "completed_at", "execution_authority"
  ],
  "properties": {
    "type": {"const": "agent.operational-activity"},
    "schema_version": {"const": "1.3.0"},
    "activity_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "activity_instance_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 512},
    "kind": {
      "enum": [
        "inventory.scan", "inventory.ontology-projection",
        "current-state.read", "observation", "assurance-twin.posture"
      ]
    },
    "status": {
      "enum": ["started", "completed", "failed", "superseded", "degraded"]
    },
    "owner_agent": {"enum": ["Huginn", "Heimdall", "Njord", "Freyr", "Vidar"]},
    "producer": {
      "enum": [
        "inventory-sync-job", "core-control-plane",
        "observation-campaign-job", "assurance-twin"
      ]
    },
    "observation_domain": {
      "oneOf": [
        {
          "enum": [
            "inventory", "activity-log", "resource-health", "service-health",
            "metrics", "logs", "guest-logs", "network-config", "cost", "recovery"
          ]
        },
        {"type": "null"}
      ]
    },
    "observed_at": {"type": "string", "format": "date-time"},
    "source": {"type": "string", "minLength": 1, "maxLength": 128},
    "freshness": {"enum": ["fresh", "stale", "unavailable", "unknown"]},
    "evidence_count": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "duration_ms": {
      "oneOf": [
        {"type": "integer", "minimum": 0, "maximum": 86400000},
        {"type": "null"}
      ]
    },
    "correlation_id": {
      "oneOf": [
        {"type": "string", "minLength": 1, "maxLength": 512},
        {"type": "null"}
      ]
    },
    "reason_codes": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[a-z][a-z0-9_]{0,127}$"
      }
    },
    "summary_key": {
      "enum": [
        "inventory_collection", "ontology_projection",
        "current_state_observation", "source_observation", "assurance_posture"
      ]
    },
    "scope_class": {
      "enum": ["configured-estate", "source-domain", "investigation", "change-review"]
    },
    "target_count": {
      "oneOf": [
        {"type": "integer", "minimum": 0, "maximum": 1000000},
        {"type": "null"}
      ]
    },
    "result_state": {"enum": ["measured", "not-recorded", "unavailable"]},
    "result_count": {
      "oneOf": [
        {"type": "integer", "minimum": 0, "maximum": 1000000},
        {"type": "null"}
      ]
    },
    "result_unit": {
      "oneOf": [
        {"enum": ["evidence-items", "resources", "records", "signals", "receipts"]},
        {"type": "null"}
      ]
    },
    "source_cutoff": {
      "oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]
    },
    "started_at": {
      "oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]
    },
    "completed_at": {
      "oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]
    },
    "execution_authority": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "started"}}, "required": ["status"]},
      "then": {
        "properties": {
          "result_state": {"const": "not-recorded"},
          "completed_at": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "failed"}}, "required": ["status"]},
      "then": {"properties": {"result_state": {"const": "unavailable"}}}
    },
    {
      "if": {
        "properties": {"status": {"enum": ["completed", "superseded"]}},
        "required": ["status"]
      },
      "then": {
        "properties": {"result_state": {"enum": ["measured", "not-recorded"]}}
      }
    },
    {
      "if": {
        "properties": {"status": {"enum": ["failed", "degraded"]}},
        "required": ["status"]
      },
      "then": {"properties": {"reason_codes": {"minItems": 1}}}
    },
    {
      "if": {
        "properties": {"result_state": {"const": "measured"}},
        "required": ["result_state"]
      },
      "then": {
        "properties": {
          "result_count": {"type": "integer", "minimum": 0, "maximum": 1000000},
          "result_unit": {
            "enum": ["evidence-items", "resources", "records", "signals", "receipts"]
          }
        }
      },
      "else": {
        "properties": {
          "evidence_count": {"const": 0},
          "result_count": {"type": "null"},
          "result_unit": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "inventory.scan"}}, "required": ["kind"]},
      "then": {
        "properties": {
          "owner_agent": {"const": "Huginn"},
          "producer": {"const": "inventory-sync-job"},
          "observation_domain": {"type": "null"},
          "summary_key": {"const": "inventory_collection"},
          "scope_class": {"const": "configured-estate"}
        }
      }
    },
    {
      "if": {
        "properties": {"kind": {"const": "inventory.ontology-projection"}},
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "owner_agent": {"const": "Heimdall"},
          "producer": {"const": "inventory-sync-job"},
          "observation_domain": {"type": "null"},
          "summary_key": {"const": "ontology_projection"},
          "scope_class": {"const": "configured-estate"}
        }
      }
    },
    {
      "if": {
        "properties": {"kind": {"const": "current-state.read"}},
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "owner_agent": {"const": "Heimdall"},
          "producer": {"const": "core-control-plane"},
          "observation_domain": {"type": "null"},
          "summary_key": {"const": "current_state_observation"},
          "scope_class": {"const": "investigation"}
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "observation"}}, "required": ["kind"]},
      "then": {
        "properties": {
          "producer": {"const": "observation-campaign-job"},
          "observation_domain": {"type": "string"},
          "summary_key": {"const": "source_observation"},
          "scope_class": {"const": "source-domain"}
        }
      },
      "else": {"properties": {"observation_domain": {"type": "null"}}}
    },
    {
      "if": {
        "properties": {
          "kind": {"const": "observation"},
          "observation_domain": {"enum": ["inventory", "activity-log"]}
        },
        "required": ["kind", "observation_domain"]
      },
      "then": {"properties": {"owner_agent": {"const": "Huginn"}}}
    },
    {
      "if": {
        "properties": {
          "kind": {"const": "observation"},
          "observation_domain": {"const": "cost"}
        },
        "required": ["kind", "observation_domain"]
      },
      "then": {"properties": {"owner_agent": {"const": "Njord"}}}
    },
    {
      "if": {
        "properties": {
          "kind": {"const": "observation"},
          "observation_domain": {"const": "recovery"}
        },
        "required": ["kind", "observation_domain"]
      },
      "then": {"properties": {"owner_agent": {"const": "Vidar"}}}
    },
    {
      "if": {
        "properties": {
          "kind": {"const": "observation"},
          "observation_domain": {"const": "metrics"}
        },
        "required": ["kind", "observation_domain"]
      },
      "then": {"properties": {"owner_agent": {"enum": ["Heimdall", "Freyr"]}}}
    },
    {
      "if": {
        "properties": {
          "kind": {"const": "observation"},
          "observation_domain": {
            "enum": [
              "resource-health", "service-health", "logs",
              "guest-logs", "network-config"
            ]
          }
        },
        "required": ["kind", "observation_domain"]
      },
      "then": {"properties": {"owner_agent": {"const": "Heimdall"}}}
    },
    {
      "if": {
        "properties": {"kind": {"const": "assurance-twin.posture"}},
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "owner_agent": {"const": "Heimdall"},
          "producer": {"const": "assurance-twin"},
          "observation_domain": {"type": "null"},
          "summary_key": {"const": "assurance_posture"},
          "scope_class": {"const": "change-review"}
        }
      }
    },
    {
      "if": {
        "properties": {"producer": {"const": "assurance-twin"}},
        "required": ["producer"]
      },
      "then": {"properties": {"kind": {"const": "assurance-twin.posture"}}}
    }
  ]
}
