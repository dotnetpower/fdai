  "$id": "https://fdai.example/schemas/cost-governance-projection/1.0.0.json",
  "additionalProperties": false,
  "description": "Versioned server-redacted projection for one Cost Governance workspace tab.",
  "properties": {
    "complete": {
      "title": "Complete",
      "type": "boolean"
    },
    "disclosure": {
      "$ref": "#/$defs/CostDisclosurePolicy"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "items": {
      "default": [],
      "items": {
        "discriminator": {
          "mapping": {
            "optimization_case": "#/$defs/CostOptimizationCaseProjection",
            "outcome": "#/$defs/CostOutcomeProjection",
            "resource": "#/$defs/CostResourceEfficiencyProjection",
            "summary": "#/$defs/CostSummaryProjection",
            "trend": "#/$defs/CostTrendProjection"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/CostSummaryProjection"
          },
          {
            "$ref": "#/$defs/CostTrendProjection"
          },
          {
            "$ref": "#/$defs/CostResourceEfficiencyProjection"
          },
          {
            "$ref": "#/$defs/CostOptimizationCaseProjection"
          },
          {
            "$ref": "#/$defs/CostOutcomeProjection"
          }
        ]
      },
      "title": "Items",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_authority": {
      "title": "Source Authority",
      "type": "string"
    },
    "suppressed_count": {
      "default": 0,
      "minimum": 0,
      "title": "Suppressed Count",
      "type": "integer"
    },
    "surface": {
      "enum": [
        "overview",
        "resource-efficiency",
        "optimization-cases",
        "outcomes"
      ],
      "title": "Surface",
      "type": "string"
    },
    "type": {
      "const": "cost-governance.projection",
      "default": "cost-governance.projection",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "surface",
    "disclosure",
    "generated_at",
    "source_authority",
    "complete"
  ],
  "title": "CostGovernanceProjection",
  "type": "object"
