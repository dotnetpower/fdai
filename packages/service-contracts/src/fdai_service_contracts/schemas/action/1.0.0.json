{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fdai.dev/schemas/action/1.0.0",
  "title": "Action",
  "description": "An autonomous action proposed by a tier and gated by risk. Its action-level declarations cover stop conditions, rollback, blast radius, target identity, and idempotency; each executor must complete the seven-safeguard contract with dry-run, lock, duplicate suppression, and audit lifecycle.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "action_id", "idempotency_key", "event_id", "action_type",
    "target_resource_ref", "operation", "stop_condition", "stop_conditions",
    "rollback_ref", "blast_radius", "mode", "citing_rules", "created_at"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "action_id": {"type": "string", "format": "uuid"},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 512},
    "event_id": {"type": "string", "format": "uuid"},
    "action_type": {"type": "string"},
    "action_type_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "version", "catalog_digest"],
      "properties": {
        "kind": {"const": "action"},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "catalog_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "executor_identity_ref": {"type": "string", "minLength": 1},
    "workflow_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["process_id", "step_id", "proposal_ref"],
      "properties": {
        "process_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "step_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "proposal_ref": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "target_resource_ref": {"type": "string"},
    "operation": {
      "type": "string",
      "enum": [
        "create", "update", "delete", "disable", "enable", "tag", "drop", "purge",
        "scale", "restart", "failover", "rotate", "revert", "attach", "detach", "quarantine"
      ]
    },
    "params": {"type": "object", "additionalProperties": true},
    "stop_condition": {"type": "string", "minLength": 1},
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "error_rate_above", "latency_p99_above_ms", "dependent_resource_degraded",
              "time_box_exceeded_seconds", "provider_api_error_streak"
            ]
          },
          "threshold": {"type": ["number", "null"]},
          "window_seconds": {"type": ["integer", "null"], "minimum": 1},
          "seconds": {"type": ["integer", "null"], "minimum": 1},
          "count": {"type": ["integer", "null"], "minimum": 1}
        }
      }
    },
    "rollback_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["pr_revert", "scripted", "pitr", "snapshot_restore", "state_forward_only"]
        },
        "reference": {"type": ["string", "null"]}
      }
    },
    "blast_radius": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope"],
      "properties": {
        "scope": {"type": "string", "enum": ["resource", "resource_group", "subscription"]},
        "count": {"type": "integer", "minimum": 1},
        "rate_per_minute": {"type": "integer", "minimum": 1}
      }
    },
    "mode": {"type": "string", "enum": ["shadow", "enforce"]},
    "citing_rules": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
