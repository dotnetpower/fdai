{
  "$defs": {
    "AlertChangePlan": {
      "additionalProperties": false,
      "description": "Immutable no-authority commitment, reconstructed before every admission.",
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "action_type": {
          "enum": [
            "ops.update-alert-routing",
            "ops.set-alert-notification-window",
            "ops.tune-alert-evaluation",
            "ops.restore-alert-configuration"
          ],
          "title": "Action Type",
          "type": "string"
        },
        "tenant_ref": {
          "pattern": "^[a-z][a-z0-9_.:-]{0,159}$",
          "title": "Tenant Ref",
          "type": "string"
        },
        "scope_ref": {
          "pattern": "^[a-z][a-z0-9_.:-]{0,159}$",
          "title": "Scope Ref",
          "type": "string"
        },
        "requester_ref": {
          "pattern": "^[a-z][a-z0-9_.:-]{0,159}$",
          "title": "Requester Ref",
          "type": "string"
        },
        "evidence_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Evidence Digest",
          "type": "string"
        },
        "policy_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Policy Digest",
          "type": "string"
        },
        "target_revision": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Target Revision",
          "type": "string"
        },
        "treatment": {
          "$ref": "#/$defs/AlertTreatment"
        },
        "service_refs": {
          "items": {
            "pattern": "^[a-z][a-z0-9_.:-]{0,159}$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Service Refs",
          "type": "array"
        },
        "lock_refs": {
          "items": {
            "pattern": "^[a-z][a-z0-9_.:-]{0,159}$",
            "type": "string"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Lock Refs",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "max_execution_seconds": {
          "maximum": 86400,
          "minimum": 1,
          "title": "Max Execution Seconds",
          "type": "integer"
        },
        "max_observation_seconds": {
          "maximum": 86400,
          "minimum": 1,
          "title": "Max Observation Seconds",
          "type": "integer"
        },
        "max_recovery_seconds": {
          "maximum": 86400,
          "minimum": 1,
          "title": "Max Recovery Seconds",
          "type": "integer"
        },
        "rollback_ref": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Rollback Ref",
          "type": "string"
        },
        "evaluation_receipt_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evaluation Receipt Digest"
        },
        "execution_path": {
          "const": "pr_manual",
          "default": "pr_manual",
          "title": "Execution Path",
          "type": "string"
        },
        "default_mode": {
          "const": "shadow",
          "default": "shadow",
          "title": "Default Mode",
          "type": "string"
        },
        "quorum_required": {
          "const": 2,
          "default": 2,
          "title": "Quorum Required",
          "type": "integer"
        },
        "execution_authority": {
          "const": false,
          "default": false,
          "title": "Execution Authority",
          "type": "boolean"
        }
      },
      "required": [
        "action_type",
        "tenant_ref",
        "scope_ref",
        "requester_ref",
        "evidence_digest",
        "policy_digest",
        "target_revision",
        "treatment",
        "service_refs",
        "lock_refs",
        "created_at",
        "expires_at",
        "max_execution_seconds",
        "max_observation_seconds",
        "max_recovery_seconds",
        "rollback_ref"
      ],
      "title": "AlertChangePlan",
      "type": "object"
    },
    "AlertNoiseCommand": {
      "additionalProperties": false,
      "description": "A principal-bound request with no supplied facts, approvals or provider endpoints.",
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "operation": {
          "enum": [
            "alert_noise.assess",
            "alert_noise.propose"
          ],
          "title": "Operation",
          "type": "string"
        },
        "request_ref": {
          "pattern": "^[a-z][a-z0-9_.:-]{0,159}$",
          "title": "Request Ref",
          "type": "string"
        },
        "requester_ref": {
          "pattern": "^[a-z][a-z0-9_.:-]{0,159}$",
          "title": "Requester Ref",
          "type": "string"
        },
        "scope_ref": {
          "pattern": "^[a-z][a-z0-9_.:-]{0,159}$",
          "title": "Scope Ref",
          "type": "string"
        },
        "requested_at": {
          "format": "date-time",
          "title": "Requested At",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "evidence_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Digest"
        },
        "treatment": {
          "anyOf": [
            {
              "$ref": "#/$defs/AlertTreatment"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "execution_authority": {
          "const": false,
          "default": false,
          "title": "Execution Authority",
          "type": "boolean"
        }
      },
      "required": [
        "operation",
        "request_ref",
        "requester_ref",
        "scope_ref",
        "requested_at",
        "expires_at"
      ],
      "title": "AlertNoiseCommand",
      "type": "object"
    },
    "AlertNoiseResult": {
      "additionalProperties": false,
      "description": "Exact command result consumed only by the matching Operator durable request.",
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "producer": {
          "const": "Forseti",
          "default": "Forseti",
          "title": "Producer",
          "type": "string"
        },
        "command": {
          "$ref": "#/$defs/AlertNoiseCommand"
        },
        "command_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Command Digest",
          "type": "string"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "status": {
          "enum": [
            "assessment_ready",
            "proposal_ready",
            "held"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_.:-]{0,159}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "assessment": {
          "anyOf": [
            {
              "$ref": "#/$defs/NoiseAssessment"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/AlertChangePlan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "execution_authority": {
          "const": false,
          "default": false,
          "title": "Execution Authority",
          "type": "boolean"
        }
      },
      "required": [
        "command",
        "command_digest",
        "recorded_at",
        "status"
      ],
      "title": "AlertNoiseResult",
      "type": "object"
    },
    "AlertTreatment": {
      "additionalProperties": false,
      "description": "Exactly one operator-selected treatment, never a provider path or script.",
      "properties": {
        "kind": {
          "enum": [
            "routing",
            "suppression",
            "evaluation"
          ],
          "title": "Kind",
          "type": "string"
        },
        "target_ref": {
          "pattern": "^[a-z][a-z0-9_.:-]{0,159}$",
          "title": "Target Ref",
          "type": "string"
        },
        "replacement_group_ref": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_.:-]{0,159}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replacement Group Ref"
        },
        "remove_group_ref": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_.:-]{0,159}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Remove Group Ref"
        },
        "processing_rule_ref": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_.:-]{0,159}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Processing Rule Ref"
        },
        "starts_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Starts At"
        },
        "ends_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ends At"
        },
        "evaluation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Evaluation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind",
        "target_ref"
      ],
      "title": "AlertTreatment",
      "type": "object"
    },
    "Evaluation": {
      "additionalProperties": false,
      "description": "Supported threshold semantics; complex native criteria remain unsupported.",
      "properties": {
        "metric_ref": {
          "pattern": "^[a-z][a-z0-9_.:-]{0,159}$",
          "title": "Metric Ref",
          "type": "string"
        },
        "operator": {
          "enum": [
            "above",
            "below"
          ],
          "title": "Operator",
          "type": "string"
        },
        "threshold": {
          "title": "Threshold",
          "type": "number"
        },
        "window_seconds": {
          "maximum": 86400,
          "minimum": 1,
          "title": "Window Seconds",
          "type": "integer"
        },
        "frequency_seconds": {
          "maximum": 86400,
          "minimum": 1,
          "title": "Frequency Seconds",
          "type": "integer"
        },
        "aggregation": {
          "enum": [
            "average",
            "maximum",
            "minimum"
          ],
          "title": "Aggregation",
          "type": "string"
        }
      },
      "required": [
        "metric_ref",
        "operator",
        "threshold",
        "window_seconds",
        "frequency_seconds",
        "aggregation"
      ],
      "title": "Evaluation",
      "type": "object"
    },
    "NoiseAssessment": {
      "additionalProperties": false,
      "description": "Privacy-minimized report binding counts and findings to a frozen input.",
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "const": "alert-noise-evidence",
          "default": "alert-noise-evidence",
          "title": "Source",
          "type": "string"
        },
        "evidence_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Evidence Digest",
          "type": "string"
        },
        "policy_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Policy Digest",
          "type": "string"
        },
        "tenant_ref": {
          "pattern": "^[a-z][a-z0-9_.:-]{0,159}$",
          "title": "Tenant Ref",
          "type": "string"
        },
        "scope_ref": {
          "pattern": "^[a-z][a-z0-9_.:-]{0,159}$",
          "title": "Scope Ref",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "valid_until": {
          "format": "date-time",
          "title": "Valid Until",
          "type": "string"
        },
        "window_start": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window Start"
        },
        "window_end": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window End"
        },
        "coverage": {
          "enum": [
            "complete",
            "partial",
            "unavailable"
          ],
          "title": "Coverage",
          "type": "string"
        },
        "reasons": {
          "items": {
            "pattern": "^[a-z][a-z0-9_.:-]{0,159}$",
            "type": "string"
          },
          "maxItems": 32,
          "title": "Reasons",
          "type": "array"
        },
        "source_episodes": {
          "anyOf": [
            {
              "maximum": 10000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Episodes"
        },
        "notification_attempts": {
          "anyOf": [
            {
              "maximum": 10000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Notification Attempts"
        },
        "confirmed_deliveries": {
          "anyOf": [
            {
              "maximum": 10000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Confirmed Deliveries"
        },
        "acknowledgements": {
          "anyOf": [
            {
              "maximum": 10000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Acknowledgements"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/NoiseFinding"
          },
          "maxItems": 10000,
          "title": "Findings",
          "type": "array"
        },
        "execution_authority": {
          "const": false,
          "default": false,
          "title": "Execution Authority",
          "type": "boolean"
        }
      },
      "required": [
        "evidence_digest",
        "policy_digest",
        "tenant_ref",
        "scope_ref",
        "observed_at",
        "valid_until",
        "coverage",
        "reasons",
        "source_episodes",
        "notification_attempts",
        "confirmed_deliveries",
        "acknowledgements",
        "findings"
      ],
      "title": "NoiseAssessment",
      "type": "object"
    },
    "NoiseFinding": {
      "additionalProperties": false,
      "description": "A bounded explanation keyed to evidence, never a mutation instruction.",
      "properties": {
        "rule_ref": {
          "pattern": "^[a-z][a-z0-9_.:-]{0,159}$",
          "title": "Rule Ref",
          "type": "string"
        },
        "service_ref": {
          "pattern": "^[a-z][a-z0-9_.:-]{0,159}$",
          "title": "Service Ref",
          "type": "string"
        },
        "reason": {
          "enum": [
            "storm",
            "flapping",
            "overlap",
            "broad_role",
            "unowned",
            "protected",
            "incomplete"
          ],
          "title": "Reason",
          "type": "string"
        },
        "guidance": {
          "enum": [
            "review-routing",
            "review-evaluation",
            "review-ownership",
            "retain-protected",
            "collect-evidence"
          ],
          "title": "Guidance",
          "type": "string"
        },
        "source_episodes": {
          "anyOf": [
            {
              "maximum": 10000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Episodes"
        },
        "observed_deliveries": {
          "anyOf": [
            {
              "maximum": 10000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed Deliveries"
        },
        "potential_recipients_lower": {
          "anyOf": [
            {
              "maximum": 10000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Potential Recipients Lower"
        },
        "potential_recipients_upper": {
          "anyOf": [
            {
              "maximum": 10000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Potential Recipients Upper"
        },
        "duplicate_paths": {
          "default": 0,
          "maximum": 10000000,
          "minimum": 0,
          "title": "Duplicate Paths",
          "type": "integer"
        },
        "protected": {
          "title": "Protected",
          "type": "boolean"
        }
      },
      "required": [
        "rule_ref",
        "service_ref",
        "reason",
        "guidance",
        "source_episodes",
        "observed_deliveries",
        "protected"
      ],
      "title": "NoiseFinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A signed no-authority result, independently matched to the original request.",
  "properties": {
    "result": {
      "$ref": "#/$defs/AlertNoiseResult"
    },
    "signature": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Signature",
      "type": "string"
    }
  },
  "required": [
    "result",
    "signature"
  ],
  "title": "SignedAlertResult",
  "type": "object",
  "$id": "https://fdai.dev/service-contracts/alert-noise-result/1.0.0"
}
