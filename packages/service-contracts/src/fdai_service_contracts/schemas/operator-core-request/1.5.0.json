{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fdai.dev/service-contracts/operator-core-request/1.5.0",
  "title": "OperatorCoreRequestEnvelope",
  "description": "Transport-facing governed request metadata with an optional bounded semantic turn, server-resolved investigation continuation, and opt-in model trace. It grants no execution authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "correlation_id",
    "idempotency_key",
    "resource_ref",
    "request_kind",
    "requested_at"
  ],
  "properties": {
    "schema_version": {"const": "1.5.0"},
    "request_id": {"type": "string", "format": "uuid"},
    "correlation_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 512},
    "resource_ref": {"type": "string", "minLength": 1, "maxLength": 512},
    "request_kind": {"type": "string", "enum": ["query", "proposal", "semantic_query"]},
    "requested_at": {"type": "string", "format": "date-time"},
    "context_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "semantic_turn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "utterance",
        "principal",
        "session_id",
        "turn_id",
        "turn_sequence",
        "locale",
        "purpose",
        "deadline_at",
        "prior_turns",
        "execution_authority"
      ],
      "properties": {
        "utterance": {"type": "string", "minLength": 1, "maxLength": 32000},
        "principal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["subject_id", "roles"],
          "properties": {
            "subject_id": {"type": "string", "minLength": 1, "maxLength": 256},
            "principal_kind": {"type": "string", "enum": ["human", "workload"]},
            "roles": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "uniqueItems": true,
              "items": {"type": "string", "enum": ["Reader", "Contributor", "Approver", "Owner", "BreakGlass"]}
            }
          }
        },
        "session_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "turn_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "turn_sequence": {"type": "integer", "minimum": 0},
        "locale": {"type": "string", "minLength": 2, "maxLength": 35},
        "purpose": {"type": "string", "minLength": 1, "maxLength": 128},
        "deadline_at": {"type": "string", "format": "date-time"},
        "view_context_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "bound_context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {"type": "string", "enum": ["incident", "screen", "resource_group"]},
            "incident_id": {"type": "string", "minLength": 1, "maxLength": 256},
            "correlation_id": {"type": "string", "minLength": 1, "maxLength": 512},
            "screen_id": {"type": "string", "minLength": 1, "maxLength": 256},
            "resource_group_id": {"type": "string", "minLength": 1, "maxLength": 256},
            "resource_ids": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
            "principal_id": {"type": "string", "minLength": 1, "maxLength": 256},
            "principal_scope_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
            "ontology_release_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
            "source_generation": {"type": "string", "minLength": 1, "maxLength": 256},
            "selection_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
            "complete": {"type": "boolean"}
          }
        },
        "investigation_continuation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "source_session_id",
            "source_turn_id",
            "source_turn_sequence",
            "target_type",
            "target_value",
            "recovery_measure_concepts",
            "baseline_start",
            "baseline_end",
            "initial_observation_cutoff",
            "ontology_release_digest",
            "principal_manifest_digest",
            "source_frame_digest",
            "source_plan_digest",
            "source_execution_receipt_digest",
            "execution_authority"
          ],
          "properties": {
            "schema_version": {"const": "1.0.0"},
            "source_session_id": {"type": "string", "minLength": 1, "maxLength": 256},
            "source_turn_id": {"type": "string", "minLength": 1, "maxLength": 256},
            "source_turn_sequence": {"type": "integer", "minimum": 0},
            "target_type": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"},
            "target_value": {"type": "string", "minLength": 1, "maxLength": 512},
            "recovery_measure_concepts": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"}
            },
            "baseline_start": {"type": "string", "format": "date-time"},
            "baseline_end": {"type": "string", "format": "date-time"},
            "initial_observation_cutoff": {"type": "string", "format": "date-time"},
            "ontology_release_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
            "principal_manifest_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
            "source_frame_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
            "source_plan_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
            "source_execution_receipt_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
            "execution_authority": {"const": false}
          }
        },
        "prior_turns": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "content"],
            "properties": {
              "role": {"type": "string", "enum": ["user", "assistant"]},
              "content": {"type": "string", "minLength": 1, "maxLength": 8000}
            }
          }
        },
        "planning_profile": {
          "type": "string",
          "enum": ["interactive", "golden_campaign_no_t2"],
          "default": "interactive"
        },
        "include_model_trace": {"type": "boolean", "default": false},
        "cancelled": {"type": "boolean", "default": false},
        "execution_authority": {"const": false}
      }
    }
  }
}
