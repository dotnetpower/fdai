{
  "$defs": {
    "CostAmountPrecision": {
      "description": "Increasing monetary precision.",
      "enum": [
        "none",
        "band",
        "rounded",
        "exact"
      ],
      "title": "CostAmountPrecision",
      "type": "string"
    },
    "CostDisclosurePolicy": {
      "additionalProperties": false,
      "description": "Server-enforced component-wise Cost Governance disclosure ceiling.",
      "properties": {
        "amount_precision": {
          "$ref": "#/$defs/CostAmountPrecision"
        },
        "granularity": {
          "$ref": "#/$defs/CostGranularity"
        },
        "identity_visibility": {
          "$ref": "#/$defs/CostIdentityVisibility"
        },
        "rounding_increment": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "100",
          "title": "Rounding Increment"
        },
        "small_cell_minimum": {
          "default": 3,
          "maximum": 100,
          "minimum": 1,
          "title": "Small Cell Minimum",
          "type": "integer"
        }
      },
      "required": [
        "granularity",
        "identity_visibility",
        "amount_precision"
      ],
      "title": "CostDisclosurePolicy",
      "type": "object"
    },
    "CostGranularity": {
      "description": "Increasingly detailed row granularity.",
      "enum": [
        "none",
        "summary",
        "group",
        "resource"
      ],
      "title": "CostGranularity",
      "type": "string"
    },
    "CostIdentityVisibility": {
      "description": "Increasing identity disclosure.",
      "enum": [
        "none",
        "pseudonymous",
        "exact"
      ],
      "title": "CostIdentityVisibility",
      "type": "string"
    }
  },
  "$id": "https://fdai.example/schemas/cost-governance-access-grant/1.0.0.json",
  "additionalProperties": false,
  "description": "Revisioned, expiring grant for one user and bounded Cost Governance scope.",
  "properties": {
    "disclosure": {
      "$ref": "#/$defs/CostDisclosurePolicy"
    },
    "effective_at": {
      "format": "date-time",
      "title": "Effective At",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "grant_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Grant Id",
      "type": "string"
    },
    "principal_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Principal Id",
      "type": "string"
    },
    "purpose": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Purpose",
      "type": "string"
    },
    "revision": {
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scopes": {
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Scopes",
      "type": "array"
    },
    "source_authority": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Source Authority",
      "type": "string"
    },
    "type": {
      "const": "cost-governance.access-grant",
      "default": "cost-governance.access-grant",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "grant_id",
    "principal_id",
    "revision",
    "purpose",
    "scopes",
    "disclosure",
    "effective_at",
    "expires_at",
    "source_authority"
  ],
  "title": "CostAccessGrant",
  "type": "object"
}
