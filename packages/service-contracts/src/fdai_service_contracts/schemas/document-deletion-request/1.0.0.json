{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/fdai/contracts/document-deletion-request/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "idempotency_key",
    "document_id",
    "version_id",
    "upload_id",
    "requested_by",
    "expected_upload_revision",
    "expected_version_revision",
    "requested_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "request_id": {"type": "string", "format": "uuid"},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 512},
    "document_id": {"type": "string", "format": "uuid"},
    "version_id": {"type": "string", "format": "uuid"},
    "upload_id": {"type": "string", "format": "uuid"},
    "requested_by": {"type": "string", "minLength": 1, "maxLength": 256},
    "expected_upload_revision": {"type": "integer", "minimum": 1},
    "expected_version_revision": {"type": "integer", "minimum": 1},
    "requested_at": {"type": "string", "format": "date-time"}
  }
}
