.git/
.github/
.venv/
.fdai/
secrets/
logs/
tmp/
resolved-models*.json
!resolved-models.json
# Exclude root integration tests and service test trees from the build context.
# The Core runtime image ships only its frozen scenarios for replay and measurement.
tests/*
services/*/tests/*
!services/core-control-plane/tests/scenarios/
docs/*
!docs/internals/
docs/internals/*
!docs/internals/sregym-absorption-ledger.json
site/
infra/
console/
ui/
mocks/
examples/
tools/
scripts/
!scripts/deployment/local/materialize-authoritative-catalogs.py
# alembic migrations ARE shipped in the runtime image so a one-off
# Container Apps Job can run `alembic upgrade head` against the state
# store (see Dockerfile runtime stage). Do not exclude them.
*.md
!/rule-catalog/README.md
!/policies/README.md
!/README.md
.terraform/
*.tfstate*
*.tfvars
*.tfplan
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
