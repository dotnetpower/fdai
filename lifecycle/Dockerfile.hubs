ARG NODE_IMAGE
ARG PYTHON_IMAGE
ARG UV_IMAGE
ARG OPA_IMAGE

FROM ${UV_IMAGE} AS uv-tool

FROM ${OPA_IMAGE} AS opa-tool

FROM scratch AS hub-dependencies

FROM scratch AS hub-npm-cache

FROM --platform=$BUILDPLATFORM ${NODE_IMAGE} AS ui-base
ARG OFFLINE_DEPS=false
WORKDIR /src
COPY ui/calm-slate-tokens.css ui/calm-slate-primitives.css ui/

FROM ui-base AS lifecycle-ui
COPY lifecycle/hub/ui/package*.json lifecycle/hub/ui/
RUN --mount=from=hub-npm-cache,target=/seed-cache \
    if [ "$OFFLINE_DEPS" = "true" ]; then cp -R /seed-cache /tmp/npm-cache; \
      npm --prefix lifecycle/hub/ui ci --offline --cache /tmp/npm-cache; \
    else npm --prefix lifecycle/hub/ui ci; fi
COPY lifecycle/hub/ui lifecycle/hub/ui
RUN npm --prefix lifecycle/hub/ui run build

FROM ui-base AS release-ui
COPY lifecycle/release-hub/ui/package*.json lifecycle/release-hub/ui/
RUN --mount=from=hub-npm-cache,target=/seed-cache \
    if [ "$OFFLINE_DEPS" = "true" ]; then cp -R /seed-cache /tmp/npm-cache; \
      npm --prefix lifecycle/release-hub/ui ci --offline --cache /tmp/npm-cache; \
    else npm --prefix lifecycle/release-hub/ui ci; fi
COPY lifecycle/hub/ui/src/auth.ts lifecycle/hub/ui/src/auth.ts
COPY lifecycle/hub/ui/src/auth.css lifecycle/hub/ui/src/auth.css
COPY lifecycle/hub/ui/tsconfig.json lifecycle/hub/ui/tsconfig.json
COPY lifecycle/hub/ui/public lifecycle/hub/ui/public
COPY lifecycle/release-hub/ui lifecycle/release-hub/ui
RUN npm --prefix lifecycle/release-hub/ui run build

FROM ${PYTHON_IMAGE} AS wheels
ARG OFFLINE_DEPS=false
ENV UV_PROJECT_ENVIRONMENT=/opt/hub
COPY --from=uv-tool /uv /usr/local/bin/uv
WORKDIR /src
COPY packages/service-contracts packages/service-contracts
COPY packages/deployment-cli packages/deployment-cli
COPY lifecycle/hub lifecycle/hub
RUN --mount=from=hub-dependencies,target=/wheelhouse \
    if [ "$OFFLINE_DEPS" = "true" ]; then \
      uv export --project lifecycle/hub --frozen --no-dev --no-emit-local \
        -o /runtime-requirements.txt >/dev/null && \
      uv venv /build && uv pip install --python /build/bin/python --offline --no-index \
        --find-links /wheelhouse hatchling==1.31.0 && \
      uv build --wheel --no-build-isolation --python /build/bin/python \
        --out-dir /wheels packages/service-contracts && \
      uv build --wheel --no-build-isolation --python /build/bin/python \
        --out-dir /wheels packages/deployment-cli && \
      uv build --wheel --no-build-isolation --python /build/bin/python \
        --out-dir /wheels lifecycle/hub && \
      uv venv /opt/hub && \
      uv pip install --python /opt/hub/bin/python --offline --no-index \
        --find-links /wheelhouse --require-hashes -r /runtime-requirements.txt && \
      uv pip install --python /opt/hub/bin/python --offline --no-index \
        --no-deps /wheels/*.whl; \
    else UV_HTTP_RETRIES=0 UV_HTTP_TIMEOUT=15 uv sync \
      --project lifecycle/hub --frozen --no-dev --no-editable; fi

FROM wheels AS release-wheels
COPY lifecycle/release-hub lifecycle/release-hub
RUN --mount=from=hub-dependencies,target=/wheelhouse \
    if [ "$OFFLINE_DEPS" = "true" ]; then \
      uv export --project lifecycle/release-hub --frozen --no-dev --no-emit-local \
        -o /release-requirements.txt >/dev/null && \
      uv pip install --python /opt/hub/bin/python --offline --no-index \
        --find-links /wheelhouse --require-hashes -r /release-requirements.txt && \
      uv build --wheel --no-build-isolation --python /build/bin/python \
        --out-dir /release-wheels lifecycle/release-hub && \
      uv pip install --python /opt/hub/bin/python --offline --no-index \
        --no-deps /release-wheels/*.whl; \
    else UV_HTTP_RETRIES=0 UV_HTTP_TIMEOUT=15 uv sync \
      --project lifecycle/release-hub --frozen --no-dev --no-editable; fi

FROM ${PYTHON_IMAGE} AS base
RUN test -s /etc/ssl/certs/ca-certificates.crt \
    && groupadd --gid 10001 hub && useradd --uid 10001 --gid hub --no-create-home hub \
    && mkdir /state && chown hub:hub /state
ENV PATH="/opt/hub/bin:$PATH"
WORKDIR /app
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["python", "-m", "fdai_lifecycle_hub.remote"]
CMD ["serve"]

FROM base AS target
COPY --from=opa-tool --chmod=0555 /opa /usr/local/bin/opa
COPY --from=wheels /opt/hub /opt/hub
COPY --from=lifecycle-ui /src/lifecycle/hub/ui/dist /app/ui

FROM base AS release
COPY --from=release-wheels /opt/hub /opt/hub
COPY --from=release-ui /src/lifecycle/release-hub/ui/dist /app/ui
