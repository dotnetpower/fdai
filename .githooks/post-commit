#!/usr/bin/env -S LC_ALL=C LANG=C bash
# Post-commit hook - Pure-Rust lightweight commit marker (zero Python dependency).
set -uo pipefail

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$repo_root" || exit 0

mkdir -p .fdai 2>/dev/null || true
git rev-parse --short HEAD > .fdai/last-commit-sha 2>/dev/null || true
exit 0
