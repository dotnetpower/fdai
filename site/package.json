{
  "name": "fdai-site",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "FDAI documentation site (Astro Starlight, GitHub Pages).",
  "scripts": {
    "mount-docs": "node scripts/mount-docs.mjs",
    "gen-og": "node scripts/gen-og-image.mjs",
    "gen-nebula": "node scripts/gen-nebula-still.mjs",
    "predev": "npm run mount-docs",
    "prebuild": "npm run mount-docs",
    "prestart": "npm run mount-docs",
    "prepreview": "npm run mount-docs",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "check:built": "node scripts/check-built-site.mjs",
    "test": "node --test test/*.test.mjs",
    "test:ui": "playwright test",
    "typecheck:ui": "tsc -p tsconfig.ui.json",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.36.0",
    "astro": "^5.14.0",
    "remark-cjk-friendly": "2.3.1",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.58.2",
    "@types/node": "22.20.0",
    "parse5": "^7.3.0",
    "playwright-core": "1.58.2",
    "typescript": "^5.9.0"
  }
}
