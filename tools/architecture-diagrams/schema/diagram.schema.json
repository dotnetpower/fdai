{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fdai.example/schemas/architecture-diagram.json",
  "title": "FDAI architecture diagram",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "kind", "locales", "canvas", "groups", "nodes", "edges"],
  "properties": {
    "id": { "$ref": "#/definitions/id" },
    "version": { "type": "integer", "minimum": 1 },
    "formats": {
      "type": "array",
      "items": { "enum": ["svg", "png"] },
      "contains": { "const": "svg" },
      "uniqueItems": true
    },
    "kind": {
      "enum": ["context", "container", "component", "deployment", "data-flow", "flowchart", "graph", "network", "conceptual-flow", "sequence", "swimlane", "state", "decision-tree", "domain", "entity-relationship", "timeline", "gantt"]
    },
    "updated": { "type": "string", "format": "date" },
    "locales": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "ko"],
      "properties": {
        "en": { "$ref": "#/definitions/documentText" },
        "ko": { "$ref": "#/definitions/documentText" }
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "direction"],
      "properties": {
        "width": { "type": "integer", "minimum": 640, "maximum": 2400 },
        "height": { "type": "integer", "minimum": 360, "maximum": 1800 },
        "direction": { "enum": ["RIGHT", "DOWN"] },
        "rootLayout": { "enum": ["row", "column"] },
        "padding": { "type": "integer", "minimum": 16, "maximum": 160, "default": 40 },
        "profile": { "enum": ["default", "azure-reference", "conceptual"], "default": "default" }
      }
    },
    "groups": {
      "type": "array",
      "items": { "$ref": "#/definitions/group" }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/definitions/edge" }
    },
    "legend": {
      "type": "array",
      "items": { "$ref": "#/definitions/legendItem" }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "url"],
        "properties": {
          "label": { "$ref": "#/definitions/localizedText" },
          "url": { "type": "string", "format": "uri" }
        }
      }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "ko"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "ko": { "type": "string", "minLength": 1 }
      }
    },
    "documentText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "alt"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "alt": { "type": "string", "minLength": 1 }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "parent": { "$ref": "#/definitions/id" },
        "kind": { "enum": ["system", "cloud", "region", "network", "subnet", "cluster", "layer"] },
        "presentation": { "enum": ["boundary", "band", "panel", "lane", "sidebar", "feedback", "datastore"] },
        "label": { "$ref": "#/definitions/localizedText" },
        "description": { "$ref": "#/definitions/localizedText" },
        "direction": { "enum": ["RIGHT", "DOWN"] },
        "layout": { "enum": ["flow", "row", "column", "free"] },
        "gap": { "type": "integer", "minimum": 8, "maximum": 240 },
        "justify": { "enum": ["start", "center", "space-between"] },
        "placement": { "enum": ["top", "below", "right"] },
        "placementGap": { "type": "integer", "minimum": 8, "maximum": 240 },
        "alignWith": { "$ref": "#/definitions/id" },
        "width": { "type": "integer", "minimum": 152, "maximum": 1200 }
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "side"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "side": { "enum": ["NORTH", "EAST", "SOUTH", "WEST"] }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "parent": { "$ref": "#/definitions/id" },
        "kind": { "enum": ["azure-service", "service", "process", "store", "external", "person", "agent", "decision"] },
        "presentation": { "enum": ["card", "icon"] },
        "shape": { "enum": ["card", "diamond", "terminator", "database", "document", "circle", "bar"] },
        "tone": { "enum": ["input", "interpretation", "model", "policy", "decision", "execution", "feedback", "store", "neutral"] },
        "badge": { "type": "integer", "minimum": 1, "maximum": 99 },
        "icon": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "label": { "$ref": "#/definitions/localizedText" },
        "description": { "$ref": "#/definitions/localizedText" },
        "content": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/definitions/localizedText" }
        },
        "start": {
          "oneOf": [
            { "type": "number" },
            { "type": "string", "format": "date" }
          ]
        },
        "end": {
          "oneOf": [
            { "type": "number" },
            { "type": "string", "format": "date" }
          ]
        },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "after": { "$ref": "#/definitions/id" },
        "status": { "enum": ["planned", "active", "done", "critical", "milestone"] },
        "progress": { "type": "number", "minimum": 0, "maximum": 100 },
        "width": { "type": "integer", "minimum": 96, "maximum": 360 },
        "height": { "type": "integer", "minimum": 64, "maximum": 220 },
        "ports": {
          "type": "array",
          "items": { "$ref": "#/definitions/port" }
        }
      }
    },
    "endpoint": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*(?::[a-z0-9][a-z0-9-]*)?$"
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "kind"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "from": { "$ref": "#/definitions/endpoint" },
        "to": { "$ref": "#/definitions/endpoint" },
        "kind": { "enum": ["request", "event", "approval", "mutation", "audit", "rollback", "read", "write", "feedback", "sequence", "transition", "association", "dependency", "timeline"] },
        "label": { "$ref": "#/definitions/localizedText" },
        "protocol": { "type": "string", "minLength": 1 },
        "route": { "enum": ["diagonal", "curve", "orthogonal", "orthogonal-shortest", "orthogonal-horizontal", "orthogonal-trunk", "orthogonal-top", "orthogonal-above", "orthogonal-right", "orthogonal-outer"] },
        "lane": { "type": "integer", "minimum": -8, "maximum": 8 },
        "step": { "type": "integer", "minimum": 1, "maximum": 99 }
      }
    },
    "legendItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "kind": { "enum": ["request", "event", "approval", "mutation", "audit", "rollback", "read", "write", "feedback", "sequence", "transition", "association", "dependency", "timeline"] },
        "tone": { "enum": ["input", "interpretation", "model", "policy", "decision", "execution", "feedback", "store", "neutral"] },
        "label": { "$ref": "#/definitions/localizedText" }
      },
      "oneOf": [
        { "properties": { "kind": {} }, "required": ["kind"] },
        { "properties": { "tone": {} }, "required": ["tone"] }
      ]
    }
  }
}
