#!/usr/bin/env sh
set -eu

repo_root=$(CDPATH= cd -P -- "${0%/*}/../.." && pwd)
migration_entry="$repo_root/service-migrations/migrate.py"

if [ -n "${FDAI_MIGRATION_PYTHON:-}" ]; then
	exec "$FDAI_MIGRATION_PYTHON" "$migration_entry" operator-service "$@"
fi

if [ -x "$repo_root/.venv/bin/python" ]; then
	exec "$repo_root/.venv/bin/python" "$migration_entry" operator-service "$@"
fi

if command -v uv >/dev/null 2>&1; then
	exec uv run --frozen --project "$repo_root" --extra dev python "$migration_entry" operator-service "$@"
fi

printf '%s\n' \
	'error: no supported project Python found; set FDAI_MIGRATION_PYTHON, create .venv, or install uv' \
	>&2
exit 127
