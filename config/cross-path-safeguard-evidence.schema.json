{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fdai.dev/schemas/cross-path-safeguard-evidence-contract/1.0.0",
  "title": "CrossPathSafeguardEvidenceContract",
  "description": "Predeclared FDAI-CONST-007 matrix over every registered ExecutionPath, orchestration origin, and execution venue on one pinned revision. The contract declares what evidence a campaign must retain; it grants no execution, deployment, approval, or promotion authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign",
    "status",
    "evidence_level",
    "base_revision",
    "execution",
    "observation",
    "matrix",
    "denial_classes",
    "acceptance",
    "evidence",
    "runbook_ref",
    "verifier_ref",
    "residuals"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "campaign": {"const": "cross-path-safeguard-evidence"},
    "status": {"enum": ["prepared", "complete"]},
    "evidence_level": {
      "enum": ["contract_only", "live_execution"],
      "description": "contract_only means no live effect has been produced. A campaign may only claim live_execution after a protected deployment of base_revision and retained independent observations."
    },
    "base_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "Exact pushed commit every matrix cell must share."
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protected_runner_required",
        "plan_only_by_default",
        "requires_current_human_approval",
        "approver_must_differ_from_initiator",
        "max_affected_resources",
        "dispatch_is_not_success",
        "forward_dispatch_must_stop_on_unknown"
      ],
      "properties": {
        "protected_runner_required": {"const": true},
        "plan_only_by_default": {"const": true},
        "requires_current_human_approval": {"const": true},
        "approver_must_differ_from_initiator": {"const": true},
        "max_affected_resources": {"type": "integer", "minimum": 1, "maximum": 1},
        "dispatch_is_not_success": {"const": true},
        "forward_dispatch_must_stop_on_unknown": {"const": true}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observer_identity_must_differ",
        "unknown_is_hold",
        "allow_synthetic_evidence",
        "max_source_age_seconds",
        "max_evidence_window_seconds",
        "unknown_outcomes"
      ],
      "properties": {
        "observer_identity_must_differ": {"const": true},
        "unknown_is_hold": {"const": true},
        "allow_synthetic_evidence": {"const": false},
        "max_source_age_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "max_evidence_window_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "unknown_outcomes": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": ["missing", "stale", "conflicting", "censored", "unavailable"]
          }
        }
      }
    },
    "matrix": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/cell"}
    },
    "denial_classes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core_pre_dispatch", "isolated_bundle_revalidation", "observation_hold"],
      "properties": {
        "core_pre_dispatch": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        },
        "isolated_bundle_revalidation": {
          "type": "array",
          "minItems": 7,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}
        },
        "observation_hold": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "every_eligible_cell_requires_observation",
        "every_denial_class_must_be_exercised",
        "require_same_base_revision",
        "require_independent_review",
        "max_unresolved_medium_findings"
      ],
      "properties": {
        "every_eligible_cell_requires_observation": {"const": true},
        "every_denial_class_must_be_exercised": {"const": true},
        "require_same_base_revision": {"const": true},
        "require_independent_review": {"const": true},
        "max_unresolved_medium_findings": {"const": 0}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_dir", "output_path", "retention_days"],
      "properties": {
        "receipt_dir": {"type": "string", "pattern": "^\\.fdai/evidence/[a-z0-9-]+/$"},
        "output_path": {"type": "string", "pattern": "^\\.fdai/evidence/[a-z0-9-]+\\.json$"},
        "retention_days": {"type": "integer", "minimum": 90, "maximum": 90}
      }
    },
    "runbook_ref": {"type": "string", "pattern": "^docs/runbooks/[a-z0-9-]+\\.md$"},
    "verifier_ref": {"type": "string", "pattern": "^scripts/quality/repository/[a-z0-9-]+\\.py$"},
    "residuals": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
    }
  },
  "$defs": {
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_id",
        "execution_path",
        "execution_origin",
        "execution_venue",
        "eligibility"
      ],
      "properties": {
        "cell_id": {"type": "string", "pattern": "^[a-z_]+:[a-z]+:[a-z_]+$"},
        "execution_path": {
          "enum": ["pr_native", "pr_manual", "direct_api", "tool_call"]
        },
        "execution_origin": {"enum": ["core", "workflow"]},
        "execution_venue": {"enum": ["core", "isolated_executor"]},
        "eligibility": {"enum": ["eligible", "structurally_denied"]},
        "action_type_ref": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*@\\d+\\.\\d+\\.\\d+$"
        },
        "observation_source": {
          "enum": ["azure_vm_power_state", "github_pull_request", "github_issue"]
        },
        "denial_reason": {
          "enum": [
            "path_unreachable_no_action_type_declares_it",
            "venue_supports_direct_api_effect_authority_only"
          ]
        },
        "denial_evidence": {"type": "string", "minLength": 1, "maxLength": 512},
        "notes": {"type": "string", "minLength": 1, "maxLength": 512}
      },
      "allOf": [
        {
          "if": {"properties": {"eligibility": {"const": "eligible"}}},
          "then": {
            "required": ["action_type_ref", "observation_source"],
            "not": {"required": ["denial_reason"]}
          }
        },
        {
          "if": {"properties": {"eligibility": {"const": "structurally_denied"}}},
          "then": {
            "required": ["denial_reason", "denial_evidence"],
            "not": {"required": ["action_type_ref"]}
          }
        }
      ]
    }
  }
}
