{
  "schema_version": 1,
  "mode": "plan",
  "pools": {
    "control": {
      "labels": ["self-hosted", "Linux", "X64", "fdai-ci-control"],
      "warm_idle": 2,
      "maximum": 4,
      "cpu_per_runner": 1,
      "quota_group": "container_cpu",
      "docker": false,
      "cooldown_seconds": 600
    },
    "general": {
      "labels": ["self-hosted", "Linux", "X64", "fdai-ci-general"],
      "warm_idle_low": 2,
      "warm_idle": 8,
      "maximum": 64,
      "cpu_per_runner": 4,
      "quota_group": "container_cpu",
      "docker": false,
      "cooldown_seconds": 600
    },
    "docker": {
      "labels": ["self-hosted", "Linux", "X64", "fdai-ci-docker"],
      "warm_idle": 2,
      "warm_idle_low": 1,
      "maximum": 16,
      "cpu_per_runner": 4,
      "quota_group": "vm_cpu",
      "docker": true,
      "cooldown_seconds": 600
    }
  },
  "jobs": {
    "ci-admission": "control",
    "changes": "control",
    "protected-ci-source": "control",
    "required": "control",
    "python-tests": "general",
    "python-tests-ssd": "general",
    "python-tests-elastic": "general",
    "python-coverage-shards": "general",
    "python-coverage": "general",
    "operator-surfaces": "general",
    "contracts": "general",
    "governance-runtime-contracts": "general",
    "evaluation-packages": "general",
    "secret-scan": "general",
    "deps-audit": "general",
    "freeze-scenarios": "general",
    "db-integration": "docker",
    "terraform-validate": "general"
  },
  "workflow_jobs": {
    ".github/workflows/container-supply-chain.yml": {
      "ci-admission": "control",
      "select-images": "control",
      "pr-build-scan": "docker",
      "required": "control",
      "build-scan-attest": "docker",
      "canary-plan": "control",
      "canary-control": "control",
      "canary-general": "general",
      "canary-docker": "docker",
      "canary-results": "control"
    }
  },
  "slo": {
    "warm_queue_p95_seconds": 15,
    "burst_queue_p99_seconds": 90,
    "maximum_queue_seconds": 120,
    "burst_stages": [1, 4, 8, 16, 32, 64]
