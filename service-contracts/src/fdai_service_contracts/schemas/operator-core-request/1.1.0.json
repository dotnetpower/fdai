{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fdai.dev/service-contracts/operator-core-request/1.1.0",
  "title": "OperatorCoreRequestEnvelope",
  "description": "Transport-facing governed request metadata with an optional context digest. It grants no execution authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "correlation_id",
    "idempotency_key",
    "resource_ref",
    "request_kind",
    "requested_at"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1\\.\\d+\\.\\d+$"},
    "request_id": {"type": "string", "format": "uuid"},
    "correlation_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 512},
    "resource_ref": {"type": "string", "minLength": 1, "maxLength": 512},
    "request_kind": {"type": "string", "enum": ["query", "proposal"]},
    "requested_at": {"type": "string", "format": "date-time"},
    "context_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
