{
  "mechanisms": [
    {
      "kql": "AppRequests\n| extend resource_id = tolower(tostring(coalesce(column_ifexists('_ResourceId', ''), column_ifexists('ResourceId', ''), column_ifexists('ClusterId', ''))))\n| where ResultCode startswith '5' or Success == false\n| project at=TimeGenerated, resource_id, magnitude=todouble(1.0)",
      "log_table": "AppRequests",
      "mechanism_id": "failed_requests",
      "owner_agent": "Heimdall",
      "predicate": "ResultCode startswith '5' or Success == false"
    },
    {
      "kql": "AppExceptions\n| extend resource_id = tolower(tostring(coalesce(column_ifexists('_ResourceId', ''), column_ifexists('ResourceId', ''), column_ifexists('ClusterId', ''))))\n| where isnotempty(ExceptionType)\n| project at=TimeGenerated, resource_id, magnitude=todouble(1.0)",
      "log_table": "AppExceptions",
      "mechanism_id": "error_timeline",
      "owner_agent": "Heimdall",
      "predicate": "isnotempty(ExceptionType)"
    },
    {
      "kql": "AppDependencies\n| extend resource_id = tolower(tostring(coalesce(column_ifexists('_ResourceId', ''), column_ifexists('ResourceId', ''), column_ifexists('ClusterId', ''))))\n| where todouble(DurationMs) >= 1000.0\n| project at=TimeGenerated, resource_id, magnitude=todouble(1.0)",
      "log_table": "AppDependencies",
      "mechanism_id": "dependency_latency",
      "owner_agent": "Heimdall",
      "predicate": "todouble(DurationMs) >= 1000.0"
    },
    {
      "kql": "AppTraces\n| extend resource_id = tolower(tostring(coalesce(column_ifexists('_ResourceId', ''), column_ifexists('ResourceId', ''), column_ifexists('ClusterId', ''))))\n| where SeverityLevel >= 2\n| project at=TimeGenerated, resource_id, magnitude=todouble(1.0)",
      "log_table": "AppTraces",
      "mechanism_id": "slow_traces",
      "owner_agent": "Heimdall",
      "predicate": "SeverityLevel >= 2"
    },
    {
      "kql": "Event\n| extend resource_id = tolower(tostring(coalesce(column_ifexists('_ResourceId', ''), column_ifexists('ResourceId', ''), column_ifexists('ClusterId', ''))))\n| where EventID in (41, 1074, 6006, 6008)\n| project at=TimeGenerated, resource_id, magnitude=todouble(1.0)",
      "log_table": "Event",
      "mechanism_id": "guest_shutdown",
      "owner_agent": "Heimdall",
      "predicate": "EventID in (41, 1074, 6006, 6008)"
    },
    {
      "kql": "KubePodInventory\n| extend resource_id = tolower(tostring(coalesce(column_ifexists('_ResourceId', ''), column_ifexists('ResourceId', ''), column_ifexists('ClusterId', ''))))\n| where todouble(ContainerRestartCount) > 0\n| project at=TimeGenerated, resource_id, magnitude=todouble(1.0)",
      "log_table": "KubePodInventory",
      "mechanism_id": "container_restarts",
      "owner_agent": "Heimdall",
      "predicate": "todouble(ContainerRestartCount) > 0"
    },
    {
      "kql": "AzureDiagnostics\n| extend resource_id = tolower(tostring(coalesce(column_ifexists('_ResourceId', ''), column_ifexists('ResourceId', ''), column_ifexists('ClusterId', ''))))\n| where ResultType == '429' or httpStatusCode_d == 429\n| project at=TimeGenerated, resource_id, magnitude=todouble(1.0)",
      "log_table": "AzureDiagnostics",
      "mechanism_id": "throttling",
      "owner_agent": "Heimdall",
      "predicate": "ResultType == '429' or httpStatusCode_d == 429"
    },
    {
      "kql": "AzureMetrics\n| extend resource_id = tolower(tostring(coalesce(column_ifexists('_ResourceId', ''), column_ifexists('ResourceId', ''), column_ifexists('ClusterId', ''))))\n| where Average >= 90.0 or Maximum >= 95.0\n| project at=TimeGenerated, resource_id, magnitude=todouble(1.0)",
      "log_table": "AzureMetrics",
      "mechanism_id": "resource_saturation",
      "owner_agent": "Heimdall",
      "predicate": "Average >= 90.0 or Maximum >= 95.0"
    },
    {
      "kql": "NTANetAnalytics\n| extend resource_id = tolower(tostring(coalesce(column_ifexists('_ResourceId', ''), column_ifexists('ResourceId', ''), column_ifexists('ClusterId', ''))))\n| where FlowStatus == 'Denied'\n| project at=TimeGenerated, resource_id, magnitude=todouble(1.0)",
      "log_table": "NTANetAnalytics",
      "mechanism_id": "network_flow_drop",
      "owner_agent": "Heimdall",
      "predicate": "FlowStatus == 'Denied'"
    },
    {
      "kql": "AZFWNetworkRule\n| extend resource_id = tolower(tostring(coalesce(column_ifexists('_ResourceId', ''), column_ifexists('ResourceId', ''), column_ifexists('ClusterId', ''))))\n| where Action == 'Deny'\n| project at=TimeGenerated, resource_id, magnitude=todouble(1.0)",
      "log_table": "AZFWNetworkRule",
      "mechanism_id": "firewall_deny",
      "owner_agent": "Heimdall",
      "predicate": "Action == 'Deny'"
    },
    {
      "kql": "AZFWDnsQuery\n| extend resource_id = tolower(tostring(coalesce(column_ifexists('_ResourceId', ''), column_ifexists('ResourceId', ''), column_ifexists('ClusterId', ''))))\n| where ResponseCode != 'NOERROR'\n| project at=TimeGenerated, resource_id, magnitude=todouble(1.0)",
      "log_table": "AZFWDnsQuery",
      "mechanism_id": "dns_resolution_failure",
      "owner_agent": "Heimdall",
      "predicate": "ResponseCode != 'NOERROR'"
    },
    {
      "kql": "AGWAccessLogs\n| extend resource_id = tolower(tostring(coalesce(column_ifexists('_ResourceId', ''), column_ifexists('ResourceId', ''), column_ifexists('ClusterId', ''))))\n| where sslEnabled_s == 'on' and httpStatus_d >= 400\n| project at=TimeGenerated, resource_id, magnitude=todouble(1.0)",
      "log_table": "AGWAccessLogs",
      "mechanism_id": "tls_handshake_failure",
      "owner_agent": "Heimdall",
      "predicate": "sslEnabled_s == 'on' and httpStatus_d >= 400"
    },
    {
      "kql": "AzureDiagnostics\n| extend resource_id = tolower(tostring(coalesce(column_ifexists('_ResourceId', ''), column_ifexists('ResourceId', ''), column_ifexists('ClusterId', ''))))\n| where OperationName contains 'Certificate' and ResultType != 'Success'\n| project at=TimeGenerated, resource_id, magnitude=todouble(1.0)",
      "log_table": "AzureDiagnostics",
      "mechanism_id": "certificate_expiry",
      "owner_agent": "Heimdall",
      "predicate": "OperationName contains 'Certificate' and ResultType != 'Success'"
    },
    {
      "kql": "AzureSQLDeadlocks\n| extend resource_id = tolower(tostring(coalesce(column_ifexists('_ResourceId', ''), column_ifexists('ResourceId', ''), column_ifexists('ClusterId', ''))))\n| where isnotempty(deadlock_xml_s)\n| project at=TimeGenerated, resource_id, magnitude=todouble(1.0)",
      "log_table": "AzureSQLDeadlocks",
      "mechanism_id": "sql_deadlock",
      "owner_agent": "Heimdall",
      "predicate": "isnotempty(deadlock_xml_s)"
    },
    {
      "kql": "AzureSQLBlocks\n| extend resource_id = tolower(tostring(coalesce(column_ifexists('_ResourceId', ''), column_ifexists('ResourceId', ''), column_ifexists('ClusterId', ''))))\n| where todouble(duration_ms_d) >= 5000.0\n| project at=TimeGenerated, resource_id, magnitude=todouble(1.0)",
      "log_table": "AzureSQLBlocks",
      "mechanism_id": "sql_blocking_session",
      "owner_agent": "Heimdall",
      "predicate": "todouble(duration_ms_d) >= 5000.0"
    },
    {
      "kql": "StorageBlobLogs\n| extend resource_id = tolower(tostring(coalesce(column_ifexists('_ResourceId', ''), column_ifexists('ResourceId', ''), column_ifexists('ClusterId', ''))))\n| where StatusText contains 'ServerBusy' or StatusCode >= 500\n| project at=TimeGenerated, resource_id, magnitude=todouble(1.0)",
      "log_table": "StorageBlobLogs",
      "mechanism_id": "storage_iops_saturation",
      "owner_agent": "Heimdall",
      "predicate": "StatusText contains 'ServerBusy' or StatusCode >= 500"
    },
    {
      "kql": "InsightsMetrics\n| extend resource_id = tolower(tostring(coalesce(column_ifexists('_ResourceId', ''), column_ifexists('ResourceId', ''), column_ifexists('ClusterId', ''))))\n| where Name == 'DiskTransfersPerSec' and Val >= 500.0\n| project at=TimeGenerated, resource_id, magnitude=todouble(1.0)",
      "log_table": "InsightsMetrics",
      "mechanism_id": "disk_queue_saturation",
      "owner_agent": "Heimdall",
      "predicate": "Name == 'DiskTransfersPerSec' and Val >= 500.0"
