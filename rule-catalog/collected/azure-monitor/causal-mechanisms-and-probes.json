    {
      "kql": "KubeEvents\n| extend resource_id = tolower(tostring(coalesce(column_ifexists('_ResourceId', ''), column_ifexists('ResourceId', ''), column_ifexists('ClusterId', ''))))\n| where Reason == 'OOMKilling' or Message contains 'OutOfMemory'\n| project at=TimeGenerated, resource_id, magnitude=todouble(1.0)",
