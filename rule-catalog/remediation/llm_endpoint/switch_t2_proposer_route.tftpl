# T2 proposer route switch intent
#
# This template records the bounded control-plane mutation reviewed through
# human approval. Thor validates the same values against current durable state
# before applying the route change.

target_resource_ref = "${target_resource_ref}"
target_route_ref = "${target_route_ref}"
prior_route_ref = "${prior_route_ref}"
reason_code = "${reason_code}"
