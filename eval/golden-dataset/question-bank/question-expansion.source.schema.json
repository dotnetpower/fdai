{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dotnetpower/fdai/eval/golden-dataset/question-bank/question-expansion.source.schema.json",
  "title": "FDAI operator question expansion source",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_id", "questions"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "source_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,159}$"
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/question"}
    }
  },
  "$defs": {
    "domain": {
      "enum": [
        "state_incident_detection",
        "root_cause_analysis",
        "change_deployment_impact",
        "dependency_impact",
        "capacity_performance_forecast",
        "reliability_policy_automation",
        "cost_finops"
      ]
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "domain",
        "intent",
        "target_kinds",
        "temporal_scope",
        "result_shape",
        "required_context",
        "wording"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,159}$"
        },
        "category": {
          "enum": [
            "current_health",
            "incident",
            "root_cause",
            "metrics_observability",
            "aks_kubernetes",
            "azure_infrastructure_network",
            "database_storage",
            "cost_finops",
            "capacity_scaling",
            "prediction",
            "dependency_impact",
            "change_deployment_release"
          ]
        },
        "domain": {"$ref": "#/$defs/domain"},
        "intent": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,159}$"
        },
        "target_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9]{0,63}$"
          }
        },
        "temporal_scope": {
          "enum": ["current", "historical", "comparison", "forecast"]
        },
        "result_shape": {
          "enum": ["assessment", "comparison", "graph", "list", "ranked_list", "timeline"]
        },
        "required_context": {
          "enum": ["none", "incident_binding", "explicit_target", "server_scope"]
        },
        "wording": {
          "type": "object",
          "additionalProperties": false,
          "required": ["en", "ko"],
          "properties": {
            "en": {"type": "string", "minLength": 8, "maxLength": 500},
            "ko": {"type": "string", "minLength": 8, "maxLength": 500}
          }
        },
        "safety": {
          "type": "object",
          "additionalProperties": false,
          "required": ["action_posture", "execution_authority"],
          "properties": {
            "action_posture": {"enum": ["read_only", "advise_only", "draft_only"]},
            "execution_authority": {"const": false}
          }
        },
        "duplicate_of": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,159}$"
        }
      }
    }
  }
}
