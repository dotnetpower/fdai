{
  "schema_version": "1.0.0",
  "origin": "independently_authored_synthetic_holdout",
  "independently_reviewed": true,
  "production_qualification": false,
  "supersedes": "instance-holdout.v4.json",
  "corpus": "instance-corpus.v1.json",
  "purpose": "Half B of a frozen independent 128-case holdout for one pre-registered ontology instance-retrieval qualification; not production qualification.",
  "candidate_ranking_policy": {
    "minimum_score": 0.4,
    "exact_weight": 1.0,
    "lexical_weight": 0.25,
    "semantic_weight": 1.0
  },
  "evaluation_policy": {
    "schema_version": "1.1.0",
    "top_k": 5,
    "min_recall_at_k": 1.0,
    "min_mean_reciprocal_rank": 1.0,
    "min_no_match_precision": 1.0,
    "min_samples_per_metric": 4,
    "required_cohorts": [
      "en-adversarial",
      "en-ambiguous",
      "en-negative",
      "en-positive",
      "ko-adversarial",
      "ko-ambiguous",
      "ko-negative",
      "ko-positive"
    ]
  },
  "limits": {
    "embedding_calls": 128,
    "total_seconds": 600,
    "embedding_call_seconds": 5
  },
