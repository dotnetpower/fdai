{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fdai.dev/schemas/rule-catalog/signal-types/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "types"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "types": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "dispatch_mode", "event_type_patterns", "description"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$",
            "maxLength": 128
          },
          "dispatch_mode": {"type": "string", "enum": ["baseline", "exact"]},
          "event_type_patterns": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 128}
          },
          "description": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      }
    }
  }
}
