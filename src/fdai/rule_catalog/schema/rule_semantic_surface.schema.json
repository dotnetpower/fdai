{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fdai.dev/schemas/rule-semantic-surface/1.0.0",
  "title": "RuleSemanticSurface",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "surface_id", "manifest_digest", "locale", "origin",
    "intent_ids", "concept_refs", "aliases", "training_queries",
    "hard_negative_queries", "producer_ref", "evidence_refs", "state",
    "validation_receipt_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "surface_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,511}$"},
    "manifest_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "locale": {"type": "string", "pattern": "^[a-z]{2,8}$"},
    "origin": {"type": "string", "enum": ["authored", "generated", "feedback"]},
    "intent_ids": {"$ref": "#/$defs/textArray"},
    "concept_refs": {"$ref": "#/$defs/textArray"},
    "aliases": {"$ref": "#/$defs/optionalTextArray"},
    "training_queries": {"$ref": "#/$defs/textArray"},
    "hard_negative_queries": {"$ref": "#/$defs/textArray"},
    "producer_ref": {"type": "string", "minLength": 1, "maxLength": 512},
    "evidence_refs": {"$ref": "#/$defs/textArray"},
    "state": {"const": "promoted"},
    "prompt_digest": {
      "anyOf": [
        {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        {"type": "null"}
      ]
    },
    "validation_receipt_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  },
  "$defs": {
    "textArray": {
      "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 4096}
    },
    "optionalTextArray": {
      "type": "array", "maxItems": 256, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 4096}
    }
  }
}
