{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fdai.dev/schemas/ontology/interface-implementation/1.0.0",
  "title": "OntologyInterfaceImplementationSet",
  "description": "Binds one semantic interface to explicit ObjectType declarations.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "interface", "object_types"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "interface": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]{0,63}$"
    },
    "object_types": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9]{0,63}$"},
      "uniqueItems": true
    }
  }
}
