{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fdai.dev/schemas/response-outcome/1.0.0",
  "title": "ResponseOutcome",
  "description": "Immutable expected-versus-observed action effect used by simulation fidelity and governed pattern learning.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "outcome_id", "idempotency_key", "action_id", "event_id",
    "action_type_id", "target_digest", "label", "verification_status",
    "verification_reason", "execution_mode", "execution_outcome", "decision",
    "evidence_refs", "recorded_at"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "outcome_id": {"type": "string", "format": "uuid"},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 512},
    "action_id": {"type": "string", "format": "uuid"},
    "event_id": {"type": "string", "format": "uuid"},
    "action_type_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "target_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prediction_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 512},
    "metric": {"type": ["string", "null"], "minLength": 1, "maxLength": 512},
    "expected_min": {"type": ["number", "null"]},
    "expected_max": {"type": ["number", "null"]},
    "observed_value": {"type": ["number", "null"]},
    "predicted_at": {"type": ["string", "null"], "format": "date-time"},
    "observation_deadline": {"type": ["string", "null"], "format": "date-time"},
    "observed_at": {"type": ["string", "null"], "format": "date-time"},
    "label": {"type": "string", "enum": ["verified", "mismatch", "unscorable"]},
    "verification_status": {"type": "string", "enum": ["verified", "mismatch", "hold"]},
    "verification_reason": {"type": "string", "minLength": 1, "maxLength": 512},
    "execution_mode": {"type": "string", "enum": ["shadow", "enforce"]},
    "execution_outcome": {"type": "string", "minLength": 1, "maxLength": 512},
    "decision": {"type": "string", "enum": ["auto", "hil", "deny", "abstain"]},
    "rollback_succeeded": {"type": ["boolean", "null"]},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    },
    "recorded_at": {"type": "string", "format": "date-time"}
  }
}
