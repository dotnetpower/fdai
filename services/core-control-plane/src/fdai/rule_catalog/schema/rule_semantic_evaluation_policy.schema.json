{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fdai.dev/schemas/rule-semantic-evaluation-policy/1.0.0",
  "title": "RuleSemanticEvaluationPolicy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "top_k",
    "min_recall_at_k",
    "min_mean_reciprocal_rank",
    "min_no_match_precision",
    "required_cohorts"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "top_k": {"type": "integer", "minimum": 1, "maximum": 100},
    "min_recall_at_k": {"type": "number", "minimum": 0, "maximum": 1},
    "min_mean_reciprocal_rank": {"type": "number", "minimum": 0, "maximum": 1},
    "min_no_match_precision": {"type": "number", "minimum": 0, "maximum": 1},
    "required_cohorts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,255}$"
      }
    }
  }
}
