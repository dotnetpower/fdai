{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fdai.dev/schemas/rule-catalog/property-semantics/1.0.0",
  "title": "PropertySemanticRegistry",
  "description": "Reviewed canonical meanings for equivalent provider property paths.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "semantics"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "semantics": {
      "type": "array",
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/semantic"}
    }
  },
  "$defs": {
    "scalar": {
      "type": ["string", "integer", "number", "boolean"]
    },
    "semantic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_id",
        "value_type",
        "normalization_rule",
        "authority",
        "freshness",
        "equivalent_provider_paths"
      ],
      "properties": {
        "semantic_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "maxLength": 128
        },
        "value_type": {
          "type": "string",
          "enum": ["string", "integer", "number", "boolean", "object", "array", "datetime"]
        },
        "canonical_unit": {"type": "string", "minLength": 1, "maxLength": 64},
        "enum_values": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/scalar"},
          "default": []
        },
        "range": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "minimum": {"type": "number"},
            "maximum": {"type": "number"}
          }
        },
        "normalization_rule": {
          "type": "string",
          "enum": [
            "string.trim",
            "string.trim_casefold",
            "integer.strict",
            "number.decimal",
            "boolean.strict",
            "datetime.rfc3339_utc",
            "identity"
          ]
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["class", "source_identity_required"],
          "properties": {
            "class": {
              "type": "string",
              "enum": [
                "catalog_owned",
                "fdai_owned",
                "provider_observed",
                "ledger_owned",
                "derived"
              ]
            },
            "source_identity_required": {"type": "boolean"}
          }
        },
        "freshness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_age_seconds", "stale_behavior"],
          "properties": {
            "max_age_seconds": {"type": "integer", "minimum": 1},
            "stale_behavior": {
              "type": "string",
              "enum": ["unknown", "lower_autonomy"]
            }
          }
        },
        "equivalent_provider_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["provider", "resource_type", "path"],
            "properties": {
              "provider": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "resource_type": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)*$"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^\\S+$"
              }
            }
          }
        }
      }
    }
  }
}
