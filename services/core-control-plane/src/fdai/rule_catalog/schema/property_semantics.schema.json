{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fdai.dev/schemas/rule-catalog/property-semantics/1.0.0",
  "title": "PropertySemanticRegistry",
  "description": "Reviewed canonical meanings for equivalent provider property paths.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "semantics", "provenance"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "semantics": {
      "type": "array",
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/semantic"}
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "scalar": {
      "type": ["string", "integer", "number", "boolean"]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_url", "resolved_ref", "content_hash", "license", "retrieved_at"],
      "properties": {
        "source_url": {"type": "string", "minLength": 1, "maxLength": 512},
        "resolved_ref": {"type": "string", "minLength": 1, "maxLength": 256},
        "content_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "license": {"type": "string", "minLength": 1, "maxLength": 128},
        "retrieved_at": {"type": "string", "format": "date-time"}
      }
    },
    "semantic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_id",
        "value_type",
        "normalization_rule",
        "authority",
        "freshness",
        "equivalent_provider_paths"
      ],
      "properties": {
        "semantic_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "maxLength": 128
        },
        "value_type": {
          "type": "string",
          "enum": ["string", "integer", "number", "boolean", "datetime"]
        },
        "canonical_unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9._/%-]{0,63}$"
        },
        "enum_values": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/scalar"},
          "default": []
        },
        "range": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "minimum": {"type": "number"},
            "maximum": {"type": "number"}
          }
        },
        "normalization_rule": {
          "type": "string",
          "enum": [
            "string.trim",
            "string.trim_casefold",
            "integer.strict",
            "number.decimal",
            "boolean.strict",
            "datetime.rfc3339_utc"
          ]
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["class", "source_identity_required"],
          "properties": {
            "class": {
              "type": "string",
              "enum": [
                "catalog_owned",
                "fdai_owned",
                "provider_observed",
                "ledger_owned",
                "derived"
              ]
            },
            "source_identity_required": {"const": true}
          }
        },
        "freshness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_age_seconds", "stale_behavior"],
          "properties": {
            "max_age_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 31536000
            },
            "stale_behavior": {
              "type": "string",
              "enum": ["unknown", "lower_autonomy"]
            }
          }
        },
        "equivalent_provider_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["provider", "resource_type", "path"],
            "properties": {
              "provider": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "resource_type": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)*$"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^\\S+$"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"value_type": {"const": "string"}}, "required": ["value_type"]},
          "then": {
            "properties": {
              "normalization_rule": {"enum": ["string.trim", "string.trim_casefold"]},
              "enum_values": {"items": {"type": "string"}}
            },
            "not": {"anyOf": [{"required": ["canonical_unit"]}, {"required": ["range"]}]}
          }
        },
        {
          "if": {"properties": {"value_type": {"const": "integer"}}, "required": ["value_type"]},
          "then": {
            "properties": {
              "normalization_rule": {"const": "integer.strict"},
              "enum_values": {"items": {"type": "integer"}},
              "range": {
                "properties": {
                  "minimum": {"type": "integer"},
                  "maximum": {"type": "integer"}
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"value_type": {"const": "number"}}, "required": ["value_type"]},
          "then": {
            "properties": {
              "normalization_rule": {"const": "number.decimal"},
              "enum_values": {
                "items": {
                  "anyOf": [{"type": "number"}, {"type": "string"}]
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"value_type": {"const": "boolean"}}, "required": ["value_type"]},
          "then": {
            "properties": {
              "normalization_rule": {"const": "boolean.strict"},
              "enum_values": {"items": {"type": "boolean"}}
            },
            "not": {"anyOf": [{"required": ["canonical_unit"]}, {"required": ["range"]}]}
          }
        },
        {
          "if": {"properties": {"value_type": {"const": "datetime"}}, "required": ["value_type"]},
          "then": {
            "properties": {
              "normalization_rule": {"const": "datetime.rfc3339_utc"},
              "enum_values": {"items": {"type": "string"}}
            },
            "not": {"anyOf": [{"required": ["canonical_unit"]}, {"required": ["range"]}]}
          }
        },
        {"not": {"required": ["range", "enum_values"]}}
      ]
    }
  }
}
