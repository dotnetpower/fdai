{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fdai.dev/schemas/rule-catalog/resource-types/1.0.0",
  "title": "ResourceTypeRegistry",
  "description": "Canonical CSP-neutral resource_type vocabulary. Every entry is quoted as-is from rule.resource_type; renames require a governance PR + catalog migration.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "types"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "category_query_terms": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "compute": {"$ref": "#/$defs/queryTerms"},
        "network": {"$ref": "#/$defs/queryTerms"},
        "storage": {"$ref": "#/$defs/queryTerms"},
        "database": {"$ref": "#/$defs/queryTerms"},
        "security": {"$ref": "#/$defs/queryTerms"},
        "observability": {"$ref": "#/$defs/queryTerms"},
        "governance": {"$ref": "#/$defs/queryTerms"}
      },
      "default": {}
    },
    "query_groups": {
      "type": "array",
      "items": {"$ref": "#/$defs/queryGroup"},
      "default": []
    },
    "types": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "queryTerms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": ".*\\S.*"
      },
      "uniqueItems": true,
      "default": []
    },
    "azureKindTokens": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9.-]*$",
        "maxLength": 128
      },
      "uniqueItems": true,
      "default": []
    },
    "queryGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "terms", "members"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "terms": {"$ref": "#/$defs/queryTerms"},
        "members": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string"}
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "description"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9\\-]*(\\.[a-z][a-z0-9\\-]*)*$",
          "description": "CSP-neutral identifier. Lower kebab; may contain dots as namespace separators (e.g. `compute.vm`)."
        },
        "category": {
          "type": "string",
          "enum": [
            "compute",
            "network",
            "storage",
            "database",
            "security",
            "observability",
            "governance"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "azure_arm_type": {
          "type": ["string", "null"],
          "description": "The Azure Resource Manager type path the provider adapter renders this resource to. `null` when Azure has no direct counterpart at this abstraction level."
        },
        "azure_kind_tokens": {
          "$ref": "#/$defs/azureKindTokens",
          "description": "Case-insensitive Azure `kind` tokens used only to disambiguate entries that share one ARM type."
        },
        "query_terms": {
          "$ref": "#/$defs/queryTerms",
          "description": "Reviewed natural-language forms that resolve to this semantic resource type."
        },
        "typical_parents": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true,
          "default": [],
          "description": "Informational only: typical `contains` parents. The authoritative graph is populated by the inventory adapter."
        }
      }
    }
  }
}
