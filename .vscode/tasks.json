{
  // FDAI developer tasks. The folderOpen tasks make trunk-based
  // (no-branch) collaboration safe out of the box and restore optional WSL
  // private DNS. Start the complete local Console topology explicitly:
  //   - "hooks: install" wires the shared pre-commit and pre-push gates.
  //   - "git: auto-pull" keeps local `main` close to the remote so
  //     conflicts surface early. It only rebases a clean working tree.
  // Trust the workspace so its committed automatic-task policy can run.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "hooks: install (core.hooksPath)",
      "hide": true,
      "type": "shell",
      "command": "git config core.hooksPath .githooks && chmod +x .githooks/* scripts/automation/git-auto-pull.sh 2>/dev/null; echo 'pre-commit and pre-push hooks installed (core.hooksPath=.githooks)'",
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "close": true
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "label": "git: auto-pull (background)",
      "hide": true,
      "type": "shell",
      "command": "bash scripts/automation/git-auto-pull.sh",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "panel": "dedicated",
        "group": "git-auto-pull"
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "label": "dev-access: configure VPN on folder open",
      "hide": true,
      "type": "shell",
      "command": "bash tools/dev-access/scripts/vscode-startup.sh",
      "problemMatcher": "$gcc",
      "presentation": {
        "reveal": "silent",
        "revealProblems": "onProblem",
        "panel": "dedicated",
        "group": "dev-access",
        "close": true,
        "showReuseMessage": false
      },
      "runOptions": {
        "runOn": "folderOpen",
        "instanceLimit": 1
      }
    },
    {
      "label": "git: pull now (rebase, autostash)",
      "type": "shell",
      "command": "git pull --rebase --autostash",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true
      }
    },
    {
      "label": "console: Playwright quick (desktop)",
      "type": "shell",
      "command": "npm --prefix console run test:e2e:quick",
      "problemMatcher": [],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "console-playwright",
        "clear": true,
        "showReuseMessage": false
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "design mocks: serve (5373)",
      "type": "shell",
      "command": "python3 -u -m http.server 5373 --bind 127.0.0.1",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "design-mocks",
        "pattern": {
          "regexp": "^(?!)$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Serving HTTP on 127\\.0\\.0\\.1 port 5373",
          "endsPattern": "^Serving HTTP on 127\\.0\\.0\\.1 port 5373"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "group": "design-mocks"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "console: prepare full stack",
      "type": "shell",
      "command": "bash scripts/deployment/local/prepare-console-full-stack.sh",
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "group": "console-full-stack",
        "close": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "console: start core runtime",
      "type": "shell",
      "command": "bash scripts/deployment/local/run-console-service.sh core-runtime --wait-ready",
      "isBackground": true,
      "problemMatcher": {
        "owner": "console-core-runtime",
        "pattern": { "regexp": "^(?!)$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "service=core-runtime event=starting$",
          "endsPattern": "service=core-runtime event=ready$"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "group": "console-full-stack",
        "clear": true,
        "showReuseMessage": false
      },
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "silent"
      }
    },
    {
      "label": "console: restart core runtime",
      "type": "shell",
      "command": "bash scripts/deployment/local/run-console-service.sh core-runtime --wait-ready",
      "isBackground": true,
      "problemMatcher": {
        "owner": "console-core-runtime-restart",
        "pattern": { "regexp": "^(?!)$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "service=core-runtime event=starting$",
          "endsPattern": "service=core-runtime event=ready$"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "group": "console-core-restart",
        "clear": true,
        "showReuseMessage": false
      },
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "silent"
      }
    },
    {
      "label": "console: start local services",
      "hide": true,
      "type": "shell",
      "command": "bash scripts/deployment/local/start-console-services.sh",
      "isBackground": true,
      "problemMatcher": {
        "owner": "console-local-services",
        "pattern": { "regexp": "^(?!)$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "service=console-stack event=starting$",
          "endsPattern": "service=console-stack event=(ready|failed)(?: |$)"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "group": "console-full-stack",
        "clear": true,
        "close": true,
        "showReuseMessage": false
      },
      "runOptions": {
        "instanceLimit": 2,
        "instancePolicy": "concurrency"
      }
    },
    {
      "label": "console: wait full stack ready",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python scripts/automation/run-bounded-command.py --label console-readiness-check --timeout-seconds 15 --no-progress-seconds 15 -- ${workspaceFolder}/.venv/bin/python scripts/automation/developer-workflow.py local-services --wait-seconds 10",
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "revealProblems": "onProblem",
        "panel": "dedicated",
        "group": "console-full-stack",
        "close": true,
        "showReuseMessage": false
      },
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "silent"
      }
    },
    {
      "label": "console: require primary worktree",
      "hide": true,
      "type": "shell",
      "command": "git_dir=\"$(git rev-parse --path-format=absolute --git-dir)\" && common_dir=\"$(git rev-parse --path-format=absolute --git-common-dir)\" && if [[ \"$git_dir\" != \"$common_dir\" ]]; then echo \"Full-stack startup is available only from the primary checkout. Stop the primary stack before starting services from a linked worktree.\" >&2; exit 75; fi",
      "problemMatcher": []
    },
    {
      "label": "console: start full stack",
      "dependsOrder": "sequence",
      "dependsOn": [
        "console: require primary worktree",
        "console: prepare full stack",
        "console: start local services"
      ],
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 2,
        "instancePolicy": "concurrency"
      }
    },
    {
      "label": "console: keep full stack ready (10m)",
      "type": "shell",
      "command": "bash scripts/deployment/local/watch-console-services.sh",
      "dependsOrder": "sequence",
      "dependsOn": [
        "console: require primary worktree"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "console-watchdog",
        "pattern": { "regexp": "^(?!)$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "service=console-watchdog event=started",
          "endsPattern": "service=console-watchdog event=started"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "group": "console-full-stack",
        "clear": true,
        "showReuseMessage": false
      },
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "silent"
      }
    },
    {
      "label": "channel edge: Operator Slack and Teams (Local)",
      "type": "shell",
      "command": "bash scripts/deployment/local/run-console-service.sh operator-channel-edge",
      "isBackground": true,
      "problemMatcher": {
        "owner": "operator-channel-edge",
        "pattern": { "regexp": "^(?!)$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*service=operator-channel-edge event=starting$",
          "endsPattern": "Application startup complete\\.|event=reused$"
        }
      },
      "presentation": {
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "group": "operator-channel-edge",
        "clear": true,
        "showReuseMessage": false
      },
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "silent"
      }
    }
  ]
}
