{
  // FDAI developer tasks. The folderOpen tasks make trunk-based
  // (no-branch) collaboration safe out of the box, and the optional
  // dev-access task restores WSL private DNS when local VPN state exists:
  //   - "hooks: install" wires the shared pre-commit and pre-push gates.
  //   - "git: auto-pull" keeps local `main` close to the remote so
  //     conflicts surface early. It only rebases a clean working tree.
  // First-open note: VS Code asks once to allow automatic tasks
  // ("Manage Automatic Tasks" -> Allow). Trust the workspace to enable.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "hooks: install (core.hooksPath)",
      "type": "shell",
      "command": "git config core.hooksPath .githooks && chmod +x .githooks/* scripts/automation/git-auto-pull.sh 2>/dev/null; echo 'pre-commit and pre-push hooks installed (core.hooksPath=.githooks)'",
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "close": true
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "label": "git: auto-pull (background)",
      "type": "shell",
      "command": "bash scripts/automation/git-auto-pull.sh",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "panel": "dedicated",
        "group": "git-auto-pull"
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "label": "dev-access: configure VPN on folder open",
      "type": "shell",
      "command": "bash tools/dev-access/scripts/vscode-startup.sh",
      "problemMatcher": "$gcc",
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "group": "dev-access",
        "close": false,
        "showReuseMessage": false
      },
      "runOptions": {
        "runOn": "folderOpen",
        "instanceLimit": 1
      }
    },
    {
      "label": "git: pull now (rebase, autostash)",
      "type": "shell",
      "command": "git pull --rebase --autostash",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true
      }
    },
    {
      "label": "design mocks: serve (5373)",
      "type": "shell",
      "command": "python3 -u -m http.server 5373 --bind 127.0.0.1",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "design-mocks",
        "pattern": {
          "regexp": "^(?!)$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Serving HTTP on 127\\.0\\.0\\.1 port 5373",
          "endsPattern": "^Serving HTTP on 127\\.0\\.0\\.1 port 5373"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "group": "design-mocks"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "console: prepare local runtime env",
      "type": "shell",
      "command": "env -u AZURE_CONFIG_DIR bash scripts/deployment/azure/prepare-local-runtime-env.sh",
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "group": "console-full-stack",
        "close": true
      }
    },
    {
      "label": "console: sync local Entra redirects",
      "type": "shell",
      "command": "set -a && source console/.env.local && set +a && for origin in http://localhost:5273 http://127.0.0.1:5273; do env -u AZURE_CONFIG_DIR .venv/bin/python scripts/deployment/azure/sync-entra-spa-redirect.py --tenant-id \"$VITE_MSAL_TENANT_ID\" --spa-client-id \"$VITE_MSAL_CLIENT_ID\" --origin \"$origin\" --allow-loopback-http; done",
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "group": "console-full-stack",
        "close": true
      }
    },
    {
      "label": "console: prepare local Operator Service env",
      "type": "shell",
      "command": "bash scripts/deployment/local/prepare-operator-service-env.sh",
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "group": "console-full-stack",
        "close": true
      }
    },
    {
      "label": "console: prepare local independent service envs",
      "type": "shell",
      "command": "bash scripts/deployment/local/prepare-independent-service-envs.sh",
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "group": "console-full-stack",
        "close": true
      }
    },
    {
      "label": "console: refresh authoritative inventory",
      "type": "shell",
      "command": "set -a && source .fdai/local-runtime.env && set +a && PYTHONPATH=\"$PWD/services/core-control-plane/src:$PWD/packages/service-contracts/src\" .venv/bin/python scripts/deployment/local/refresh-authoritative-inventory.py",
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "group": "console-full-stack",
        "close": true
      }
    },
    {
      "label": "console: refresh authoritative settings",
      "type": "shell",
      "command": "set -a && source .fdai/local-runtime.env && set +a && PYTHONPATH=\"$PWD/services/core-control-plane/src:$PWD/packages/service-contracts/src\" .venv/bin/python scripts/deployment/local/materialize-authoritative-settings.py",
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "group": "console-full-stack",
        "close": true
      }
    },
    {
      "label": "console: prepare local state",
      "type": "shell",
      "command": "bash scripts/deployment/local/prepare-console-state.sh",
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "group": "console-full-stack",
        "close": true
      },
      "runOptions": {
        "runOn": "folderOpen",
        "instanceLimit": 1
      }
    },
    {
      "label": "console: prepare full stack",
      "dependsOrder": "sequence",
      "dependsOn": [
        "console: prepare local state",
        "console: prepare local runtime env",
        "console: refresh authoritative inventory",
        "console: refresh authoritative settings",
        "console: prepare local Operator Service env",
        "console: prepare local independent service envs",
        "console: sync local Entra redirects"
      ],
      "problemMatcher": []
    },
    {
      "label": "console: Core Control Plane (Local Docker)",
      "type": "shell",
      "command": "set -a && source .fdai/local-runtime.env && set +a && FDAI_LOCAL_SERVICE_LOG_FORMAT=json-plain bash scripts/automation/run-local-service.sh core-runtime \"$PWD/.fdai/logs/core-runtime.log\" -- env -u AZURE_CONFIG_DIR FDAI_RUNTIME_LOCK_FILE=\"$PWD/.fdai/core-runtime.lock\" PYTHONPATH=\"$PWD/services/core-control-plane/src:$PWD/packages/service-contracts/src${PYTHONPATH:+:$PYTHONPATH}\" .venv/bin/python -m fdai",
      "isBackground": true,
      "problemMatcher": {
        "owner": "console-core-runtime",
        "pattern": {
          "regexp": "^(?!)$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*service=core-runtime event=starting$",
          "endsPattern": "pantheon_bridge_started"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "console-core-runtime",
        "clear": true,
        "showReuseMessage": false
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "console: Operator API (Local Entra)",
      "type": "shell",
      "command": "set -a && source .fdai/local-operator-service.env && set +a && FDAI_LOCAL_SERVICE_LOG_FORMAT=json-plain bash scripts/automation/run-local-service.sh operator-api \"$PWD/.fdai/logs/operator-api.log\" -- env -u AZURE_CONFIG_DIR PYTHONPATH=\"$PWD/services/operator-service/src:$PWD/packages/service-contracts/src${PYTHONPATH:+:$PYTHONPATH}\" .venv/bin/python -m uvicorn fdai_operator_service.main:create_app --factory --host 127.0.0.1 --port 8010 --no-access-log",
      "dependsOn": "console: prepare full stack",
      "isBackground": true,
      "problemMatcher": {
        "owner": "console-operator-api",
        "pattern": {
          "regexp": "^(?!)$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*service=operator-api event=starting$",
          "endsPattern": "Application startup complete\\."
        }
      },
      "presentation": {
        "reveal": "silent",
        "focus": false,
        "panel": "dedicated",
        "group": "console-operator-api",
        "clear": true,
        "showReuseMessage": false
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "console: Document Ingestion API (Local Docker)",
      "type": "shell",
      "command": "set -a && source .fdai/local-document-ingestion-api.env && set +a && FDAI_LOCAL_SERVICE_LOG_FORMAT=json-plain bash scripts/automation/run-local-service.sh document-ingestion-api \"$PWD/.fdai/logs/document-ingestion-api.log\" -- env -u AZURE_CONFIG_DIR PYTHONPATH=\"$PWD/services/document-ingestion-api/src:$PWD/packages/service-contracts/src${PYTHONPATH:+:$PYTHONPATH}\" .venv/bin/python -m uvicorn fdai_ingestion_api_service.main:create_app --factory --host 127.0.0.1 --port 8011 --no-access-log",
      "dependsOn": "console: prepare full stack",
      "isBackground": true,
      "problemMatcher": {
        "owner": "console-document-ingestion-api",
        "pattern": { "regexp": "^(?!)$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*service=document-ingestion-api event=starting$",
          "endsPattern": "Application startup complete\\."
        }
      },
      "presentation": {
        "reveal": "silent",
        "focus": false,
        "panel": "dedicated",
        "group": "console-document-ingestion-api",
        "clear": true,
        "showReuseMessage": false
      },
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "console: Document Processing Worker (Local Docker)",
      "type": "shell",
      "command": "set -a && source .fdai/local-document-processing-worker.env && set +a && FDAI_LOCAL_SERVICE_LOG_FORMAT=json-plain bash scripts/automation/run-local-service.sh document-processing-worker \"$PWD/.fdai/logs/document-processing-worker.log\" -- env -u AZURE_CONFIG_DIR PYTHONPATH=\"$PWD/services/document-processing-worker/src:$PWD/packages/service-contracts/src${PYTHONPATH:+:$PYTHONPATH}\" .venv/bin/fdai-document-processing-worker",
      "dependsOn": "console: prepare full stack",
      "isBackground": true,
      "problemMatcher": {
        "owner": "console-document-processing-worker",
        "pattern": { "regexp": "^(?!)$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*service=document-processing-worker event=starting$",
          "endsPattern": "ingestion_worker_status"
        }
      },
      "presentation": {
        "reveal": "silent",
        "focus": false,
        "panel": "dedicated",
        "group": "console-document-processing-worker",
        "clear": true,
        "showReuseMessage": false
      },
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "console: Isolated Executor (Local Shadow)",
      "type": "shell",
      "command": "set -a && source .fdai/local-isolated-executor.env && set +a && FDAI_LOCAL_SERVICE_LOG_FORMAT=json-plain bash scripts/automation/run-local-service.sh isolated-executor \"$PWD/.fdai/logs/isolated-executor.log\" -- env -u AZURE_CONFIG_DIR PYTHONPATH=\"$PWD/services/isolated-executor/src:$PWD/packages/service-contracts/src${PYTHONPATH:+:$PYTHONPATH}\" .venv/bin/fdai-isolated-executor-service",
      "dependsOn": "console: prepare full stack",
      "isBackground": true,
      "problemMatcher": {
        "owner": "console-isolated-executor",
        "pattern": { "regexp": "^(?!)$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*service=isolated-executor event=starting$",
          "endsPattern": "event_bus_consumer_started"
        }
      },
      "presentation": {
        "reveal": "silent",
        "focus": false,
        "panel": "dedicated",
        "group": "console-isolated-executor",
        "clear": true,
        "showReuseMessage": false
      },
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "console: frontend (Browser Entra)",
      "type": "shell",
      "command": "VITE_DEV_MODE=0 VITE_LOCAL_AZURE_CLI_AUTH=0 VITE_OPERATOR_API_BASE_URL=http://127.0.0.1:8010 VITE_INGESTION_API_BASE_URL=http://127.0.0.1:8011 npm --prefix console run dev -- --port 5273 --strictPort",
      "isBackground": true,
      "problemMatcher": {
        "owner": "console-frontend",
        "pattern": {
          "regexp": "^(?!)$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^> fdai-console@.* dev$",
          "endsPattern": "Local:\\s+http://(?:127\\.0\\.0\\.1|localhost):5273/"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "console-frontend",
        "clear": true,
        "showReuseMessage": false
      },
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ]
}
