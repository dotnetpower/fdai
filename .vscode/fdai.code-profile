{
    "name": "FDAI",
    "settings": "{\n    \"azureTerraform.languageServer\": {\n        \"args\": [\n            \"serve\"\n        ],\n        \"external\": false,\n        \"pathToBinary\": \"\",\n        \"trace.server\": \"off\"\n    },\n    \"chat.contextUsage.enabled\": true,\n    \"terraform.languageServer.indexing.ignoreDirectoryNames\": [\n        \".astro\",\n        \".fdai\",\n        \".git\",\n        \".github\",\n        \".improve\",\n        \".mypy_cache\",\n        \".pytest_cache\",\n        \".ruff_cache\",\n        \".venv\",\n        \".vite\",\n        \"__pycache__\",\n        \"alembic\",\n        \"benchmarks\",\n        \"cli\",\n        \"delivery\",\n        \"dist\",\n        \"docs\",\n        \"evaluation-sdk\",\n        \"examples\",\n        \"extensions\",\n        \"htmlcov\",\n        \"logs\",\n        \"mocks\",\n        \"node_modules\",\n        \"playwright-report\",\n        \"policies\",\n        \"rule-catalog\",\n        \"scripts\",\n        \"secrets\",\n        \"security\",\n        \"site\",\n        \"src\",\n        \"test-results\",\n        \"tests\",\n        \"tmp\",\n        \"ui\"\n    ],\n    \"workbench.localHistory.exclude\": {\n        \"**/.fdai/**\": true,\n        \"**/.git/**\": true,\n        \"**/.improve/**\": true,\n        \"**/.terraform/**\": true,\n        \"**/.venv/**\": true,\n        \"**/dist/**\": true,\n        \"**/htmlcov/**\": true,\n        \"**/node_modules/**\": true,\n        \"**/playwright-report/**\": true,\n        \"**/test-results/**\": true\n    },\n    \"workbench.localHistory.maxFileEntries\": 20,\n    \"workbench.localHistory.mergeWindow\": 60\n}",
    "extensions": "[\n    {\n        \"identifier\": {\n            \"id\": \"charliermarsh.ruff\"\n        }\n    },\n    {\n        \"identifier\": {\n            \"id\": \"dbaeumer.vscode-eslint\"\n        }\n    },\n    {\n        \"identifier\": {\n            \"id\": \"esbenp.prettier-vscode\"\n        }\n    },\n    {\n        \"identifier\": {\n            \"id\": \"github.vscode-github-actions\"\n        }\n    },\n    {\n        \"identifier\": {\n            \"id\": \"github.vscode-pull-request-github\"\n        }\n    },\n    {\n        \"identifier\": {\n            \"id\": \"hashicorp.terraform\"\n        }\n    },\n    {\n        \"identifier\": {\n            \"id\": \"ms-azuretools.azure-dev\"\n        }\n    },\n    {\n        \"identifier\": {\n            \"id\": \"ms-azuretools.vscode-azure-github-copilot\"\n        }\n    },\n    {\n        \"identifier\": {\n            \"id\": \"ms-azuretools.vscode-azure-mcp-server\"\n        }\n    },\n    {\n        \"identifier\": {\n            \"id\": \"ms-azuretools.vscode-azureresourcegroups\"\n        }\n    },\n    {\n        \"identifier\": {\n            \"id\": \"ms-playwright.playwright\"\n        }\n    },\n    {\n        \"identifier\": {\n            \"id\": \"ms-python.debugpy\"\n        }\n    },\n    {\n        \"identifier\": {\n            \"id\": \"ms-python.python\"\n        }\n    },\n    {\n        \"identifier\": {\n            \"id\": \"ms-python.vscode-pylance\"\n        }\n    },\n    {\n        \"identifier\": {\n            \"id\": \"ms-python.vscode-python-envs\"\n        }\n    },\n    {\n        \"identifier\": {\n            \"id\": \"ms-vscode.makefile-tools\"\n        }\n    },\n    {\n        \"identifier\": {\n            \"id\": \"redhat.vscode-yaml\"\n        }\n    },\n    {\n        \"identifier\": {\n            \"id\": \"timonwong.shellcheck\"\n        }\n    }\n]"
