{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FDAI Console v4 (Pure-Rust :5290)",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "build",
          "--bin=fdai-console-v4",
          "--package=fdai-console-v4"
        ],
        "filter": {
          "name": "fdai-console-v4",
          "kind": "bin"
        }
      },
      "args": [
        "--host",
        "127.0.0.1",
        "--port",
        "5290"
      ],
      "cwd": "${workspaceFolder}"
    },
    {
