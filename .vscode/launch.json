{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Design Mocks: Static Site",
      "type": "node-terminal",
      "request": "launch",
      "command": "python3 -u -m http.server 5373 --bind 127.0.0.1",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "pattern": "Serving HTTP on 127\\.0\\.0\\.1 port 5373",
        "uriFormat": "http://127.0.0.1:5373",
        "action": "debugWithChrome"
      }
    },
    {
      "name": "Console Web: Core Runtime",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "module": "fdai",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.fdai/local-runtime.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/services/core-control-plane/src:${workspaceFolder}/packages/service-contracts/src",
        "FDAI_RUNTIME_LOCK_FILE": "${workspaceFolder}/.fdai/core-runtime.lock",
        "AZURE_CONFIG_DIR": null
      },
      "console": "integratedTerminal",
      "justMyCode": true,
      "subProcess": true,
      "presentation": {
        "group": "1-fullstack",
        "order": 1
      }
    },
    {
      "name": "Console Web: Operator API",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "module": "uvicorn",
      "args": [
        "fdai_operator_service.main:create_app",
        "--factory",
        "--host",
        "127.0.0.1",
        "--port",
        "8010",
        "--no-access-log",
        "--reload"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.fdai/local-operator-service.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/services/operator-service/src:${workspaceFolder}/packages/service-contracts/src",
        "AZURE_CONFIG_DIR": null
      },
      "console": "integratedTerminal",
      "justMyCode": true,
      "subProcess": true,
      "presentation": {
        "group": "1-fullstack",
        "order": 2
      }
    },
    {
      "name": "Console Web: Ingestion Gateway",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "module": "uvicorn",
      "args": [
        "fdai.delivery.ingestion_gateway.dev:app",
        "--factory",
        "--host",
        "127.0.0.1",
        "--port",
        "8011",
        "--reload"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "FDAI_INGESTION_GATEWAY_DEV_MODE": "1",
        "FDAI_INGESTION_GATEWAY_CORS_ALLOW_ORIGINS": "http://127.0.0.1:5273,http://localhost:5273"
      },
      "console": "integratedTerminal",
      "justMyCode": true,
      "subProcess": true
    },
    {
      "name": "Console Web: Ingestion Gateway (persistent)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "module": "uvicorn",
      "args": [
        "fdai.delivery.ingestion_gateway.dev:app",
        "--factory",
        "--host",
        "127.0.0.1",
        "--port",
        "8011",
        "--reload"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "FDAI_INGESTION_GATEWAY_DEV_MODE": "1",
        "FDAI_INGESTION_GATEWAY_PERSISTENT": "1",
        "FDAI_STATE_STORE_DSN": "postgresql://fdai:devonly@127.0.0.1:5432/fdai",
        "FDAI_INGESTION_GATEWAY_CORS_ALLOW_ORIGINS": "http://127.0.0.1:5273,http://localhost:5273"
      },
      "console": "integratedTerminal",
      "justMyCode": true,
      "subProcess": true
    },
    {
      "name": "Console Web: Frontend",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev -- --port 5273 --strictPort",
      "cwd": "${workspaceFolder}/console",
      "env": {
        "VITE_LOCAL_AZURE_CLI_AUTH": "0",
        "VITE_DEV_MODE": "0",
        "VITE_LOCAL_LOGIN_PROMPT": "0",
        "VITE_OPERATOR_API_BASE_URL": "http://127.0.0.1:8010",
        "VITE_INGESTION_API_BASE_URL": "http://127.0.0.1:8011"
      },
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "debugWithChrome"
      },
      "presentation": {
        "group": "1-fullstack",
        "order": 3
      }
    }
  ],
  "compounds": [
    {
      "name": "Console Web: Full Stack",
      "preLaunchTask": "console: prepare full stack",
      "configurations": [
        "Console Web: Core Runtime",
        "Console Web: Operator API",
        "Console Web: Frontend"
      ],
      "stopAll": true,
      "presentation": {
        "group": "0-fullstack",
        "order": 1
      }
    }
  ]
}
