{
    "azureTerraform.languageServer": {
        "args": [
            "serve"
        ],
        "external": false,
        "pathToBinary": "",
        "trace.server": "off"
    },
    "liveServer.settings.host": "127.0.0.1",
    "liveServer.settings.port": 5373,
    "task.allowAutomaticTasks": "on",
    "makefile.configureOnOpen": false,
    "chat.hookFilesLocations": {
        ".github/hooks": true,
        ".claude/settings.local.json": false,
        ".claude/settings.json": false,
        "~/.agents/hooks": false,
        "~/.claude/settings.json": false,
        "~/.copilot/hooks": false
    },
    "chat.contextUsage.enabled": true,
    "chat.useNestedAgentsMdFiles": false,
    "github.copilot.chat.summarizeAgentConversationHistory.enabled": true,
    "github.copilot.chat.summarizeAgentConversationHistoryThreshold": 160000,
    "github.copilot.nextEditSuggestions.enabled": false,
    "git.autofetch": false,
    "python.analysis.include": [
        "alembic",
        "benchmarks/*/src",
        "delivery",
        "evaluation-sdk/src",
        "extensions/*/src",
        "packages/*/src",
        "scripts",
        "service-migrations",
        "services/*/src",
        "tools"
    ],
    "python.analysis.indexing": false,
    "python.analysis.logLevel": "Warning",
    "python.analysis.nodeArguments": [
        "--max-old-space-size=2048"
    ],
    "python.analysis.nodeExecutable": "auto",
    "python.analysis.useLibraryCodeForTypes": false,
    "python.analysis.userFileIndexFollowSymlinkedFolders": false,
    "files.associations": {
        "**/.github/workflows/deploy-dev.yml": "yaml"
    },
    "files.exclude": {
        "**/__pycache__": true,
        "**/.astro": true,
        "**/.mypy_cache": true,
        "**/.pytest_cache": true,
        "**/.ruff_cache": true,
        "**/.terraform": true,
        "**/.vite": true,
        "**/node_modules": true,
        ".venv": true,
        "console/playwright-report": true,
        "console/test-results": true,
        "htmlcov": true,
        "site/dist": true
    },
    "search.exclude": {
        "**/*.plan": true,
        "**/*.pyc": true,
        "**/*.tfstate*": true,
        ".improve/**": true,
        "coverage.xml": true,
        "docs/internals/**": true,
        "examples/**": true,
        "logs/**": true,
        "resolved-models*.json": true,
        "secrets/**": true,
        "tmp/**": true
    },
    "files.watcherExclude": {
        "**/__pycache__/**": true,
        "**/.astro/**": true,
        "**/.fdai/**": true,
        "**/.improve/**": true,
        "**/.mypy_cache/**": true,
        "**/.pytest_cache/**": true,
        "**/.ruff_cache/**": true,
        "**/.terraform/**": true,
        "**/.venv/**": true,
        "**/.vite/**": true,
        "**/node_modules/**": true,
        "**/playwright-report/**": true,
        "**/test-results/**": true,
        "**/dist/**": true,
        "**/htmlcov/**": true
    }
}
