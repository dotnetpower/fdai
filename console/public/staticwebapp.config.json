{
  "routes": [
    {
      "route": "/fdai-config.js",
      "headers": {
        "Cache-Control": "no-store"
      }
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/agent-icons/*",
      "/*.{css,js,json,png,jpg,jpeg,gif,svg,ico,webp,woff,woff2,map}"
    ]
  }
}
